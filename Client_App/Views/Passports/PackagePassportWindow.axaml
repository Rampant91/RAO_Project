<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:passports="clr-namespace:Models.Passports;assembly=Models"
        xmlns:interactivity="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
		xmlns:converter="clr-namespace:Client_App.VisualRealization.Converters"
        xmlns:local="using:Client_App.Behaviors"
		xmlns:vm="using:Client_App.ViewModels.Passports"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="690" MinHeight="300"
        x:Class="Client_App.Views.Passports.PackagePassportWindow"
        x:Name="Root"
        x:DataType="vm:PackagePassportWindowVM"
        Title="PackagePassportWindow">

	<Window.Resources>
		<converter:DoubleToExponentionalFormatConverter x:Key="ExpontionalFormatConverter"/>
		<converter:DateOnlyToStringConverter x:Key="DateOnlyToStringConverter"/>
		<converter:LogicalNotConverter x:Key="LogicalNotConverter"/>
	</Window.Resources>

	<Design.DataContext>				   
		<vm:PackagePassportWindowVM/>
	</Design.DataContext>
        
	<Grid ColumnDefinitions="*"
		  RowDefinitions="Auto, *">
	<Menu Grid.Row="0" 
		  x:Name="SubMenuBorder" 
		  BorderBrush="#FF959595" 
		  BorderThickness="1" 
		  Background="WhiteSmoke"
		  Height="25"
		  DockPanel.Dock="Top">

			<Menu.Styles>
				<Style Selector="Separator">
					<Setter Property="Background" Value="LightGray"/>
					<Setter Property="Margin" Value="0,5"/>
					<Setter Property="Height" Value="3"/>
				</Style>
				<Style Selector="MenuItem">
					<Setter Property="Background" Value="WhiteSmoke"/>
					<Setter Property="FontSize" Value="14"/>
				</Style>
			</Menu.Styles>
			<MenuItem Header="Файл">
				<MenuItem Header="Сохранить"
						  Command="{Binding SavePassport}"/>
				
					<MenuItem Command="{Binding ExcelExportPackagePassport}"
							  CommandParameter="{Binding Passport}"
							  Header="Выгрузить паспорт в Excel"/>
			</MenuItem>
		</Menu>
		<ScrollViewer Grid.Row ="1"
					  VerticalScrollBarVisibility="Auto"
					  HorizontalScrollBarVisibility="Disabled">

			<Grid ColumnDefinitions="*">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*" MinHeight="175" />
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

			

				<!--Header-->

				<StackPanel Grid.Row="0" HorizontalAlignment="Center">
					<TextBlock Margin="5"
							   FontWeight="Bold"
							   FontSize="18"
							   Text="ПАСПОРТ"
							   VerticalAlignment="Center"
							   TextAlignment="Center"/>
					<TextBlock Margin="5"
							   FontWeight="Bold"
							   FontSize="14"
							   VerticalAlignment="Center"
							   Text="на упаковку твердых радиоактивных отходов"
							   TextAlignment="Center"/>
					<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto" HorizontalAlignment="Center" >
						<TextBlock Grid.Row="0"
								   Grid.Column="0"
								   Margin="5"
								   FontWeight="Bold"
								   VerticalAlignment="Center"
								   Text="№"/>
						
						<TextBox Grid.Row="0"
								   Grid.Column="1"
								   Margin="5"
								 MinWidth="150"
								 Text="{Binding Passport.PassportNum}"/>
						<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="1" Text="(паспорта)" HorizontalAlignment="Center"/>

						<TextBlock Grid.Row="0"
								   Grid.Column="2"
								   Margin="5"
								   FontWeight="Bold"
								   VerticalAlignment="Center"
								   Text="от"/>
						
						<TextBox Grid.Row="0"
								   Grid.Column="3"
								   Margin="5"
								 MinWidth="150"
								 Text="{Binding Passport.PassportDate, Converter={StaticResource DateOnlyToStringConverter}}">
							<interactivity:Interaction.Behaviors>
								<local:TextBoxDateOnlyLostFocusBehavior/>
							</interactivity:Interaction.Behaviors>
						</TextBox>
						<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="3" 
							   VerticalAlignment="Center"
								   HorizontalAlignment="Center"
								   Text="(дата)" />
						
					</Grid>
					<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center">
						<TextBlock Margin="5"
								   Grid.Row="0"
								   Grid.Column="0"
								   VerticalAlignment="Center"
								   FontWeight="Bold"
								   Text="Наименование"/>
						<TextBox Margin="5"
								 Grid.Row="0"
								 Grid.Column="1"
								 MinWidth="300"
								 Text="{Binding Passport.PackageType}"/>
						<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="1"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Center"
								   Text="(тип упаковки РАО, неупакованных РАО)" />
					</Grid>
					<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center">
						<TextBlock Margin="5"
								   Grid.Row="0"
								   Grid.Column="0"
								   FontWeight="Bold"
								   VerticalAlignment="Center"
								   Text="Номер корректировки"/>
						<TextBox Margin="5"
								 Grid.Row="0"
								 Grid.Column="1"
								 MinWidth="300"
								 MaxLength="3"
								 Text="{Binding Passport.CorrectionNumber}">
							<interactivity:Interaction.Behaviors>
								<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9]+$"/>
							</interactivity:Interaction.Behaviors>
						</TextBox>
						
						<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="1" 
								    HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Text="(номер корректировки)"/>
					</Grid>

				</StackPanel>

				<Expander
					IsTabStop="False"
					Margin="5"
					Grid.Row="1"
					Header="Основная информация"
					IsExpanded="True">
					<Grid
						MaxWidth="1500"
						MinWidth="670"
						RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
						ColumnDefinitions="*,*,*,*">

						<StackPanel Grid.Row="0" Grid.Column="0"
									Orientation="Horizontal" HorizontalAlignment="Right">
							<TextBlock Margin="5"
								VerticalAlignment="Center"
								Text="Код &quot;Статус РАО&quot; -"/>

							<TextBox MinWidth="105" Margin="5"
								 Text="{Binding Passport.StatusRaoCode}" MaxLength="14">
								
								<interactivity:Interaction.Behaviors>
									<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9_]+$"/>
								</interactivity:Interaction.Behaviors>
							</TextBox>
						</StackPanel>

						<TextBox Grid.Row="0" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.TechSpecification}"/>
						<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="1"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Text="(номер технических условий)" />
						
						
						<TextBox Grid.Row="0" Grid.Column="2" Margin="5"
								 Text="{Binding Passport.NameRao}"/>
						<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="2"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Text="(название РАО)" />
						
						<TextBox Grid.Row="0" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.ClassRao}" MaxLength="1">
							<interactivity:Interaction.Behaviors>
								<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[1-6]+$"/>
							</interactivity:Interaction.Behaviors>
						</TextBox>
						
						<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="3"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Center"
								   Text="(класс РАО)" />

						<TextBlock Grid.Row="2" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
								   Text="Номер договора передачи РАО на захоронение"/>
						<TextBox Grid.Row="2" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.RaoDisposalNum}"/>
						<Grid Grid.Row="2" Grid.Column="2"
							  ColumnDefinitions="Auto,*">
							<TextBlock Grid.Column="0" Margin="5"
									   VerticalAlignment="Center"
									   Text="от"/> 
							<TextBox Grid.Column="1"
									 Margin="5"
									 Text="{Binding Passport.RaoDisposalDate, Converter={StaticResource DateOnlyToStringConverter}}">
								<interactivity:Interaction.Behaviors>
									<local:TextBoxDateOnlyLostFocusBehavior/>
								</interactivity:Interaction.Behaviors>
							</TextBox>
						</Grid>

						<TextBlock Grid.Row="3" Grid.Column="0" Margin="5"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Индивидуальный номер упаковки РАО"/>
						
						<TextBox Grid.Row="3" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.PackageIdCode}"/>
						<TextBlock Margin="5,-5,5,0" Grid.Row="4" Grid.Column="1" 
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Text="(идентификационный код)"/>

						<TextBox Grid.Row="3" Grid.Column="2" Margin="5"
								 Grid.ColumnSpan="2"
								 Text="{Binding Passport.TypeAndIdPuod}"/>
						<TextBlock Margin="5,-5,5,0" Grid.Row="4" Grid.Column="2"
								   Grid.ColumnSpan="2"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Center"
								   Text="(тип и идентификаторы ПУОД)"/>

						<TextBlock Grid.Row="5" Grid.Column="0" Margin="5"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Заводской номер контейнера"/>
						<TextBox Grid.Row="5" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.ContainerFactoryNum}"/>

						<TextBlock Grid.Row="6" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   Text="Организация-собственник упаковки РАО"/>
						<TextBox Grid.Row="6" Grid.Column="1" Margin="5"
								 Grid.ColumnSpan="2"
								 Text="{Binding Passport.Owner}"/>
						<TextBlock Margin="5,-5,5,0" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" 
								   VerticalAlignment="Center" 
								   Text="(название организации)"
								   HorizontalAlignment="Center"/>
						
						<TextBox Grid.Row="6" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.OwnerOkpo}" 
								 MaxLength="14">
							<interactivity:Interaction.Behaviors>
								<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9_]+$"/>
							</interactivity:Interaction.Behaviors>
						</TextBox>
						<TextBlock Margin="5,-5,5,0" Grid.Row="7" Grid.Column="3"
								   VerticalAlignment="Center" 
								   HorizontalAlignment="Center"
								   Text="(ОКПО)" />

						<TextBlock Grid.Row="8" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
								   VerticalAlignment="Center"
								   TextWrapping="Wrap"
								   Text="Организация-изготовитель упаковки РАО"/>
						<TextBox Grid.Row="8" Grid.Column="1" Margin="5"
								 Grid.ColumnSpan="2"
								 Text="{Binding Passport.Manufacturer}"/>
						<TextBlock Margin="5,-5,5,0" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"
								   VerticalAlignment="Center" 
								   Text="(название организации)" 
								   HorizontalAlignment="Center"/>
						
						<TextBox Grid.Row="8" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.ManufacturerOkpo}" 
								 MaxLength="14">
							<interactivity:Interaction.Behaviors>
								<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9_]+$"/>
							</interactivity:Interaction.Behaviors>
						</TextBox>
						<TextBlock Margin="5,-5,5,0" Grid.Row="9" Grid.Column="3"
								   VerticalAlignment="Center" 
								   Text="(ОКПО)"
								   HorizontalAlignment="Center"/>

						<TextBlock Grid.Row="10" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   Text="Номер сертификата соответствия на контейнер (упаковочный комплект)"/>
						<TextBox Grid.Row="10" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.CertificateConformityNum}"/>


						<TextBlock Grid.Row="10" Grid.Column="2" Margin="5"
								   HorizontalAlignment="Right"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   Text="Дата изготовления упаковки РАО"/>
						<TextBox Grid.Row="10" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.ManufactureDate, Converter={StaticResource DateOnlyToStringConverter}}">
							<interactivity:Interaction.Behaviors>
								<local:TextBoxDateOnlyLostFocusBehavior/>
							</interactivity:Interaction.Behaviors>
						</TextBox>

						<TextBlock Grid.Row="11" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   Text="Срок действия сертификата"/>
						<Grid Grid.Row="11" Grid.Column="1"
							  ColumnDefinitions="Auto,*">
							<TextBlock Grid.Column="0" Margin="5" Grid.Row="0"
										VerticalAlignment="Center" 
									   Text="с"/>
							<TextBox Grid.Column="1" Margin="5"
									 Text="{Binding Passport.CertificateConformityStartPeriod, Converter={StaticResource DateOnlyToStringConverter}}">
								<interactivity:Interaction.Behaviors>
									<local:TextBoxDateOnlyLostFocusBehavior/>
								</interactivity:Interaction.Behaviors>
							</TextBox>
						</Grid>
						<Grid Grid.Row="11" Grid.Column="2"
							  ColumnDefinitions="Auto,*">
							<TextBlock Grid.Column="0" Margin="5" Grid.Row="0"
									   VerticalAlignment="Center" 
									   Text="по"/>
							<TextBox Grid.Column="1" Margin="5"
									 Text="{Binding Passport.CertificateConformityEndPeriod, Converter={StaticResource DateOnlyToStringConverter}}">
								<interactivity:Interaction.Behaviors>
									<local:TextBoxDateOnlyLostFocusBehavior/>
								</interactivity:Interaction.Behaviors>
							</TextBox>
						</Grid>

						<TextBlock Grid.Row="12" Grid.Column="0" Margin="5"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Срок службы контейнера (упаковочного комплекта)"/>
						<TextBox Grid.Row="12" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.ServiceLife}">
							<interactivity:Interaction.Behaviors>
								<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9]+$"/>
							</interactivity:Interaction.Behaviors>
						</TextBox>
						<TextBlock Grid.Row="12" Grid.Column="2" Margin="5"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Дата передачи упаковки РАО на захоронение"/>
						<TextBox Grid.Row="12" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.TransferDate, Converter={StaticResource DateOnlyToStringConverter}}">
							<interactivity:Interaction.Behaviors>
								<local:TextBoxDateOnlyLostFocusBehavior/>
							</interactivity:Interaction.Behaviors>
						</TextBox>
					</Grid>
				</Expander>


				<!--Таблица 1-->
				<Expander
					IsTabStop="False"
					Grid.Row="2"
					Header="Общая характеристика упаковки РАО"
					IsExpanded="True"
					Margin="5">

					<ScrollViewer Margin="5" Grid.Row="3" HorizontalScrollBarVisibility="Auto">

						<interactivity:Interaction.Behaviors>
							<local:ChainingScrollViewerBehavior/>
						</interactivity:Interaction.Behaviors>

						<Grid x:Name="Table1"
							  ColumnDefinitions="Auto"
							  RowDefinitions="Auto,Auto,Auto">

							<!--#region Заголовки таблицы-->

							<Grid Grid.Row="0"
								  Width="{Binding ElementName=dataGrid.Width}"
								  Classes="tableHeader"
								  ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
								  RowDefinitions="Auto,Auto">

								<interactivity:Interaction.Behaviors>
									<local:ColumnWidthSyncBehavior SourceDataGrid="{Binding ElementName=dataGrid1}" />
								</interactivity:Interaction.Behaviors>

								<!--Первый уровень заголовков-->

								<Border Grid.Row="0"
										Grid.Column="0"
										Grid.ColumnSpan="3"
										BorderThickness="1,1,1,0">
									<TextBlock>Состав упаковки РАО</TextBlock>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="3"
										Grid.ColumnSpan="4">
									<TextBlock>Габариты упаковки РАО, мм</TextBlock>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="7"
										Grid.ColumnSpan="2">
									<TextBlock Text="Масса, кг"/>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="9"
										Grid.ColumnSpan="2">
									<TextBlock Text="Объем, м³"/>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="11"
										Grid.ColumnSpan="2">
									<TextBlock Text="Мощность дозы излучения,мк3в/ч на расстоянии от поверхности, м"/>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="13"
										Grid.ColumnSpan="2">
									<TextBlock Text="Уровень нефиксированного загрязнения, частиц/(мин*см²)"/>
								</Border>
								<!--Третий уровень заголовков-->

								<Border Grid.Row="1" Grid.Column="0">
									<TextBlock Text="Способ размещения отходов" />
								</Border>
								<Border Grid.Row="1" Grid.Column="1">
									<TextBlock Text="Наличие и вид матричного материала"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="2">
									<TextBlock Text="Дата заполнения отходами"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="3">
									<TextBlock Text="Диаметр"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="4">
									<TextBlock Text="Высота"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="5">
									<TextBlock Text="Длина"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="6">
									<TextBlock Text="Ширина"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="7">
									<TextBlock Text="упаковки РАО"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="8">
									<TextBlock Text="РАО в упаковке"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="9">
									<TextBlock Text="упаковки РАО"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="10">
									<TextBlock Text="РАО в упаковке"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="11">
									<TextBlock Text="0,1"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="12">
									<TextBlock Text="1"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="13">
									<TextBlock Text="альфа"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="14">
									<TextBlock Text="бета/гамма"/>
								</Border>
								<Border Grid.Row="0" Grid.Column="15"
										Grid.RowSpan="2">
									<TextBlock Text="Тепловыделение, Вт/м³, Вт/упаковку"/>
								</Border>

							</Grid>


							<!--#region DataGrid-->

							<DataGrid x:Name="dataGrid1"
									  Grid.Row="1"
									  CornerRadius="5"
									  CanUserResizeColumns="True"
									  RowBackground="White"
									  SelectionMode ="Single"
									  Margin="5,-5,5,5"
									  x:CompileBindings="True"
									  CanUserReorderColumns="False"
									  CanUserSortColumns="True"
									  Classes="table"
									  ColumnWidth="150"
									  MaxColumnWidth="500">


								<DataGrid.Columns>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="1" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="2" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="3" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="4" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="5" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="6" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="7" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="8" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="9" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="10" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="11" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="12" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="13" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="14" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="15" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="16" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
							<Grid Grid.Row="2"
								  Margin="6,-5,0,0"
								Classes="tableHeader"
								Width="{Binding ElementName=dataGrid.Width}"
								ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<interactivity:Interaction.Behaviors>
									<local:ColumnWidthSyncBehavior SourceDataGrid="{Binding ElementName=dataGrid1}" />
								</interactivity:Interaction.Behaviors>

								<Border Grid.Row="0" Grid.Column="0">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.DisposalMethod}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="1">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.MatrixMaterialType}" >
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="2">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.FillingWasteDate, Converter={StaticResource DateOnlyToStringConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxDateOnlyLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="3">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.Diameter}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9]+$"/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="4">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.Height}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9]+$"/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="5">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.Length}" >
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9]+$"/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="6">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.Width}" >
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9]+$"/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="7">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.PackageMass, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="8">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.RaoMass, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="9">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.PackageVolume, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="10">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.RaoVolume, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="11">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.RadiationDoseRate10cm, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="12">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.RadiationDoseRate1m, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="13">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.LevelNonFixedPollutionAlpha, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="14">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.LevelNonFixedPollutionBetaGamma, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
								<Border Grid.Row="0" Grid.Column="15">
									<TextBox
										TextWrapping="Wrap"
										Text="{Binding Passport.HeatOutput, Converter={StaticResource ExpontionalFormatConverter}}">
										<interactivity:Interaction.Behaviors>
											<local:SelectAllOnFocusBehavior/>
											<local:TextBoxExponentionalFormatLostFocusBehavior/>
										</interactivity:Interaction.Behaviors>
									</TextBox>
								</Border>
							</Grid>
						</Grid>
					</ScrollViewer>
				</Expander>
				<!--Таблица 2-->

				<Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto">
					<TextBlock Grid.Row="0"
							 FontWeight="Bold"
							 TextAlignment="Center"
							 Text ="Характеристика радиоактивного содержимого упаковки РАО"/>
					
				</Grid>

				<ScrollViewer Margin="5" Grid.Row="4" HorizontalScrollBarVisibility="Auto" 
							Height="600">

					<interactivity:Interaction.Behaviors>
						<local:ChainingScrollViewerBehavior/>
					</interactivity:Interaction.Behaviors>

					<Grid x:Name="Table2"
						  ColumnDefinitions="Auto"
						  RowDefinitions="Auto,*">

						<!--#region Контекстное меню-->

						<Grid.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Добавить первичную упаковку" 
										  Command="{Binding AddPrimaryPackage}"/>
								<MenuItem Header="Удалить первичную упаковку" 
										  Command="{Binding DeletePrimaryPackage}" 
										  CommandParameter="{Binding SelectedCharacteristic}"/>
							</ContextMenu>
						</Grid.ContextMenu>

						<!--#endregion Контекстное меню-->

						<!--#region Заголовки таблицы-->

						<Grid Grid.Row="0"
							  Width="{Binding ElementName=dataGrid.Width}"
							  Classes="tableHeader"
							  ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
							  RowDefinitions="Auto,Auto,Auto">

							<interactivity:Interaction.Behaviors>
								<local:ColumnWidthSyncBehavior SourceDataGrid="{Binding ElementName=dataGrid2}" />
							</interactivity:Interaction.Behaviors>

							<!--Первый уровень заголовков-->
							<Border Grid.Row="0" Grid.Column="7"
									Grid.ColumnSpan="3">
								<TextBlock Text="Количество и характеристики первичных упаковок"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="12"
									Grid.ColumnSpan="5">
								<TextBlock Text="Суммарные удельные активности, кБк/кг"/>
							</Border>
							<!--Второй уровень заголовков-->
							<Border Grid.Row="0" Grid.Column="0"
									Grid.RowSpan="2">
								<TextBlock Text="Тип первичной упаковки"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="1"
									Grid.RowSpan="2">
								<TextBlock Text="Номер первичной упаковки"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="2"
									Grid.RowSpan="2">
								<TextBlock Text="Класс РАО"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="3"
						   Grid.RowSpan="2">
								<TextBlock Text="Код РАО"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="4"
									Grid.RowSpan="2">
								<TextBlock Text="Физико-химическая форма РАО, тип матричного материала"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="5"
									Grid.RowSpan="2">
								<TextBlock Text="Морфологический (химический) состав отходов"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="6"
									Grid.RowSpan="2">
								<TextBlock Text="Горючесть"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="7">
								<TextBlock Text="Количество, шт."/>
							</Border>
							<Border Grid.Row="1" Grid.Column="8">
								<TextBlock Text="Объем, м³"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="9">
								<TextBlock Text="Масса с отходами, кг"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="10"
									Grid.RowSpan="2">
								<TextBlock Text="Радионуклидный состав"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="11"
									Grid.RowSpan="2">
								<TextBlock Text="Удельная активность, кБк/кг"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="12">
								<TextBlock Text="долгоживущие"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="13">
								<TextBlock Text="трансурановые"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="14">
								<TextBlock Text="альфа-изл. (за искл. т/уран.)"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="15">
								<TextBlock Text="бета/гамма- изл."/>
							</Border>
							<Border Grid.Row="1" Grid.Column="16">
								<TextBlock Text="тритий"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="17"
									Grid.RowSpan="2">
								<TextBlock Text="Общая активность, Бк"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="18"
									Grid.RowSpan="2">
								<TextBlock Text="Содержание ядерно-опасных делящихся нуклидов, кБк/кг"/>
							</Border>

						</Grid>


						<!--#region DataGrid-->

						<DataGrid
							Grid.Row="1"
							ItemsSource="{Binding Passport.ContentCharacteristics}"
							SelectedItem="{Binding SelectedCharacteristic}"
							Classes="table"
							MaxColumnWidth="500"
                            ColumnWidth="125"
							
							x:Name="dataGrid2"
							x:CompileBindings="True"
							VerticalScrollBarVisibility="Disabled">
						
							<interactivity:Interaction.Behaviors>
								<local:DataGridColumnWidthLoadBehavior FormNum="package_passport" />
								<local:DataGridPointerBehavior />
								<local:DeselectDataGridOnClickOutsideBehavior />
							</interactivity:Interaction.Behaviors>

							<DataGrid.Columns>
								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="1" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate >
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PackageType, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="2" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate >
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PackageNum, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="3" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding ClassRao, Mode=TwoWay}"
													 MaxLength="1">
												<interactivity:Interaction.Behaviors>
													<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[1-6]+$"/>
												</interactivity:Interaction.Behaviors>
											</TextBox>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="4" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding CodeRao, Mode=TwoWay}"
													 MaxLength="11">
												<interactivity:Interaction.Behaviors>
													<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9]+$"/>
												</interactivity:Interaction.Behaviors>
											</TextBox>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								
								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="5" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate >
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PhysicochemicalForm, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="6" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate >
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding MorphologicalComposition, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="7" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate >
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding Flammability, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="8" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PrimaryPackageQuantity, Mode=TwoWay}">
												<interactivity:Interaction.Behaviors>
													<local:TextBoxWhiteListValidationBehavior WhiteListRegex="^[0-9]+$"/>
												</interactivity:Interaction.Behaviors>
											</TextBox>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="9" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PrimaryPackageVolume, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}">
												<interactivity:Interaction.Behaviors>
													<local:TextBoxExponentionalFormatLostFocusBehavior/>
												</interactivity:Interaction.Behaviors>
											</TextBox>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="10" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PrimaryPackageMass, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}">
												<interactivity:Interaction.Behaviors>
													<local:TextBoxExponentionalFormatLostFocusBehavior/>
												</interactivity:Interaction.Behaviors>
											</TextBox>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="11" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">

											<StackPanel >
												<ListBox
													MaxHeight="240"
													ItemsSource="{Binding RadionuclidsList}"
													Background="Transparent"
													SelectionMode="Single">
													<ListBox.ItemTemplate >
														<DataTemplate x:DataType="passports:Radionuclid">
															<Grid ColumnDefinitions="*,Auto">
																<AutoCompleteBox
																	Classes="hitable"
																	Grid.Column="0"
																	Background="White"
																	Height="26"
																	Margin="-1"
																	BorderThickness="2"
																	FilterMode="Custom"
																	ItemFilter="{Binding VM.RadionuclidFilter, ElementName=Root}"
																	ItemsSource="{Binding VM.RaoNamesCollection, ElementName=Root}"
																	Text="{Binding Name}">
																	<interactivity:Interaction.Behaviors>
																		<local:TextBoxCalculateActivitiesOnLostFocus Radionuclid="{Binding}"/>
																	</interactivity:Interaction.Behaviors>
																</AutoCompleteBox>
																<Button Grid.Column="1"
																		IsHitTestVisible="True"
																		Content="X"
																		Width="26"
																		Height="26"
																		Command="{Binding VM.DeleteRadionuclid, ElementName=Root}"
																		CommandParameter="{Binding}"/>
															</Grid>
														</DataTemplate>
													</ListBox.ItemTemplate>
												</ListBox>
												<Button
													Content="Добавить"
													Command="{Binding VM.AddRadionuclid, ElementName=Root}"
													CommandParameter="{Binding}"/>
											</StackPanel>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="12" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<StackPanel>
												<ListBox
													MaxHeight="240"
													ItemsSource="{Binding RadionuclidsList}"
													Background="Transparent"
													SelectionMode="Single">
													<ListBox.ItemTemplate>
														<DataTemplate x:DataType="passports:Radionuclid">
															<Grid ColumnDefinitions="*,Auto">
																<TextBox Grid.Column="0"
																		 Height="26"
																		 Background="White"
																		 IsHitTestVisible="True"
																		 Text="{Binding Activity, Converter={StaticResource ExpontionalFormatConverter}}">
																	<interactivity:Interaction.Behaviors>
																		<local:TextBoxCalculateActivitiesOnLostFocus Radionuclid="{Binding}"/>
																		<local:TextBoxExponentionalFormatLostFocusBehavior/>
																	</interactivity:Interaction.Behaviors>
																</TextBox>
																<Button Grid.Column="1"
																		IsHitTestVisible="True"
																		Content="X"
																		Width="26"
																		Height="26"
																		Command="{Binding VM.DeleteRadionuclid, ElementName=Root}"
																		CommandParameter="{Binding}"/>
															</Grid>
														</DataTemplate>
													</ListBox.ItemTemplate>
												</ListBox>
												<Button
													Content="Добавить"
														Command="{Binding VM.AddRadionuclid, ElementName=Root}"
														CommandParameter="{Binding}"/>
											</StackPanel>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="13" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBlock Classes ="readOnly" Text="{Binding LongLivingActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="14" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBlock Classes ="readOnly"  Text="{Binding TransuraniumActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="15" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBlock Classes ="readOnly" Text="{Binding AlphaActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="16" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBlock Classes ="readOnly" Text="{Binding BetaGammaActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="17" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBlock Classes ="readOnly" Text="{Binding TritiumActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="18" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBlock Classes ="readOnly" Text="{Binding TotalActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="19" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding NuclearHazardousFissileNuclides, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>

					</Grid>
				</ScrollViewer>

				<TextBox Grid.Row="5"
						 AcceptsReturn="True"
						 Margin="5"
						 MaxWidth="1500"
						 Text="{Binding Passport.Notes}"
						 Watermark ="Примечания"
						 TextWrapping="Wrap"/>
			
				<!--Footer-->
				<Grid Grid.Row="6"
					  Margin="5"
					  MaxWidth="1500"
					  RowDefinitions="Auto, Auto, Auto, Auto"
					  ColumnDefinitions="Auto, *, *, *">
					<TextBlock Grid.Row="0" Grid.Column="0" Margin="5"
							   HorizontalAlignment="Right"
							   VerticalAlignment="Center"
							   Text="Ответственный за сдачу РАО"/>
					<TextBox Grid.Row="0" Grid.Column="1" Margin="5"
							 Text="{Binding Passport.ResponsibleTransfer}"/>
					<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="1" Text="(наименование организации)" HorizontalAlignment="Center"/>
					
					<TextBox Grid.Row="0" Grid.Column="2" Margin="5"
							 Text="{Binding Passport.GradeAuthorizedPersonTransfer}"/>
					<TextBlock Margin="5,-5,5,0" Grid.Row="1" Grid.Column="2" Text="(Должность уполномоченного лица)" HorizontalAlignment="Center"/>
					
					<TextBox Grid.Row="0" Grid.Column="3" Margin="5"
							 Text="{Binding Passport.FioAuthorizedPersonTransfer}"/>
					

					<TextBlock Grid.Row="2" Grid.Column="0" Margin="5"
							   HorizontalAlignment="Right"
							   VerticalAlignment="Center"
							   Text="Ответственный за прием РАО"/>
					
					<TextBox Grid.Row="2" Grid.Column="1" Margin="5"
							 Text="{Binding Passport.ResponsibleReception}"/>
					<TextBlock Margin="5,-5,5,0" Grid.Row="3" Grid.Column="1" Text="(наименование организации)" HorizontalAlignment="Center"/>
					
					<TextBox Grid.Row="2" Grid.Column="2" Margin="5"
							 Text="{Binding Passport.GradeAuthorizedPersonReception}"/>
					<TextBlock Margin="5,-5,5,0" Grid.Row="3" Grid.Column="2" Text="(Должность уполномоченного лица)" HorizontalAlignment="Center"/>
					
					<TextBox Grid.Row="2" Grid.Column="3" Margin="5"
							 Text="{Binding Passport.FioAuthorizedPersonReception}"/>
					<TextBlock Margin="5,-5,5,0" Grid.Row="3" Grid.Column="3" Text="(Фамилия И.О. уполномоченного лица)" HorizontalAlignment="Center"/>
					
				</Grid>
			</Grid>
		</ScrollViewer>
	</Grid>
</Window>