<Window x:Class="Client_App.Views.Forms.Forms1.Form_10"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Forms.Forms1"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        Title="{Binding WindowHeader, Mode=OneTime}"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.5" behaviors:WindowScreenSizeBehavior.HeightRatio="0.85"
        d:DesignWidth="720" d:DesignHeight="540"
        MinWidth="950"
        MinHeight="600"
        Classes="orgForm"
        x:CompileBindings="True"
        x:DataType="vm:Form_10VM"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <Design.DataContext>
        <vm:Form_10VM />
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MaxHeight="220" />
            <RowDefinition Height="5*" MinHeight="400" />
        </Grid.RowDefinitions>

        <!--#region Верхняя таблица-->

        <Border Grid.Row="0"
                Margin="5,15,5,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="5">

            <Grid ColumnDefinitions="330,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Classes="org-top-label"
                           Text="Орган управления использованием атомной энергии" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Classes="org-multiline"
                         Text="{Binding Storage.Rows10[0].OrganUprav.Value}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Classes="org-label"
                           Text="Регистрационный номер:" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Classes="org-field"
                         Text="{Binding Storage.RegNoRep.Value}" />
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                    <Button Height="32"
                            Margin="5,5,0,5"
                            Command="{Binding ChangeReportOrder}"
                            Content="Поменять местами"
                            IsEnabled="{Binding IsSeparateDivision}"
                            IsVisible="{Binding IsSeparateDivision}" />
                    <Button Height="30"
                            Margin="5,5,0,5"
                            Command="{Binding Reorganize}"
                            Content="Реорганизовать" />
                    <Button Height="32"
                            Margin="5,5,0,5"
                            Command="{Binding SaveReport}"
                            Content="Сохранить" />
                </StackPanel>
            </Grid>

        </Border>

        <!--#endregion Верхняя таблица-->

        <!--#region ScrollViewer-->

        <ScrollViewer Grid.Row="1"
                      MinHeight="400"
                      Margin="0,5,0,0"
                      VerticalAlignment="Top"
                      VerticalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--#region Юридическое лицо-->

                <Border Margin="5,15,5,20"
                        Padding="3,3,3,3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid ColumnDefinitions="330,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Classes="org-section-title"
                                   Text="Юридическое лицо" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="org-label" Text="Субъект Российской федерации" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].SubjectRF.Value}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="org-label" Text="Наименование юр. лица" />
                        <TextBox Grid.Row="2" Grid.Column="1" Classes="org-multiline" Text="{Binding Storage.Rows10[0].JurLico.Value}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="org-label" Text="Сокращенное наименование" />
                        <TextBox Grid.Row="3" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].ShortJurLico.Value}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="org-label" Text="Адрес места нахождения юр. лица" />
                        <TextBox Grid.Row="4" Grid.Column="1" Classes="org-multiline" Text="{Binding Storage.Rows10[0].JurLicoAddress.Value}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="org-label" Text="Фактический адрес юр. лица" />
                        <TextBox Grid.Row="5" Grid.Column="1" Classes="org-multiline" Text="{Binding Storage.Rows10[0].JurLicoFactAddress.Value}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="org-label" Text="ФИО, должность руководителя" />
                        <TextBox Grid.Row="6" Grid.Column="1" Classes="org-multiline" Text="{Binding Storage.Rows10[0].GradeFIO.Value}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Classes="org-label" Text="Телефон организации" />
                        <TextBox Grid.Row="7" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Telephone.Value}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Classes="org-label" Text="Факс организации" />
                        <TextBox Grid.Row="8" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Fax.Value}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Classes="org-label" Text="Электронная почта организации" />
                        <TextBox Grid.Row="9" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Email.Value}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Classes="org-label" Text="ОКПО" />
                        <TextBox Grid.Row="10" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Okpo.Value}" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Classes="org-label" Text="ОКВЭД" />
                        <TextBox Grid.Row="11" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Okved.Value}" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Classes="org-label" Text="ОКОГУ" />
                        <TextBox Grid.Row="12" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Okogu.Value}" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Classes="org-label" Text="ОКТМО" />
                        <TextBox Grid.Row="13" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Oktmo.Value}" />

                        <TextBlock Grid.Row="14" Grid.Column="0" Classes="org-label" Text="ИНН" />
                        <TextBox Grid.Row="14" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Inn.Value}" />

                        <TextBlock Grid.Row="15" Grid.Column="0" Classes="org-label" Text="КПП" />
                        <TextBox Grid.Row="15" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Kpp.Value}" />

                        <TextBlock Grid.Row="16" Grid.Column="0" Classes="org-label" Text="ОКОПФ" />
                        <TextBox Grid.Row="16" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Okopf.Value}" />

                        <TextBlock Grid.Row="17" Grid.Column="0" Classes="org-label" Text="ОКФС" />
                        <TextBox Grid.Row="17" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[0].Okfs.Value}" />

                    </Grid>
                </Border>

                <!--#endregion Юридическое лицо-->

                <!--#region Территориальное обособленное подразделение-->

                <Border Margin="5,0,5,20"
                        Padding="3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="5"
                        IsVisible="{Binding IsSeparateDivision}">
                    <Grid ColumnDefinitions="330,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Classes="org-section-title"
                                   Text="Территориальное обособленное подразделение" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="org-label" Text="Субъект Российской федерации" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].SubjectRF.Value}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="org-label" Text="Наименование обособленного подразделения" />
                        <TextBox Grid.Row="2" Grid.Column="1" Classes="org-multiline" Text="{Binding Storage.Rows10[1].JurLico.Value}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="org-label" Text="Сокращенное наименование" />
                        <TextBox Grid.Row="3" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].ShortJurLico.Value}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="org-label" Text="Адрес места нахождения обособленного подразделения" />
                        <TextBox Grid.Row="4" Grid.Column="1" Classes="org-multiline" Text="{Binding Storage.Rows10[1].JurLicoAddress.Value}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="org-label" Text="Фактический адрес обособленного подразделения" />
                        <TextBox Grid.Row="5" Grid.Column="1" Classes="org-multiline" Text="{Binding Storage.Rows10[1].JurLicoFactAddress.Value}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="org-label" Text="ФИО, должность руководителя" />
                        <TextBox Grid.Row="6" Grid.Column="1" Classes="org-multiline" Text="{Binding Storage.Rows10[1].GradeFIO.Value}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Classes="org-label" Text="Телефон организации" />
                        <TextBox Grid.Row="7" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Telephone.Value}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Classes="org-label" Text="Факс организации" />
                        <TextBox Grid.Row="8" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Fax.Value}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Classes="org-label" Text="Электронная почта организации" />
                        <TextBox Grid.Row="9" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Email.Value}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Classes="org-label" Text="ОКПО" />
                        <TextBox Grid.Row="10" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Okpo.Value}" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Classes="org-label" Text="ОКВЭД" />
                        <TextBox Grid.Row="11" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Okved.Value}" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Classes="org-label" Text="ОКОГУ" />
                        <TextBox Grid.Row="12" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Okogu.Value}" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Classes="org-label" Text="ОКТМО" />
                        <TextBox Grid.Row="13" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Oktmo.Value}" />

                        <TextBlock Grid.Row="14" Grid.Column="0" Classes="org-label" Text="ИНН" />
                        <TextBox Grid.Row="14" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Inn.Value}" />

                        <TextBlock Grid.Row="15" Grid.Column="0" Classes="org-label" Text="КПП" />
                        <TextBox Grid.Row="15" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Kpp.Value}" />

                        <TextBlock Grid.Row="16" Grid.Column="0" Classes="org-label" Text="ОКОПФ" />
                        <TextBox Grid.Row="16" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Okopf.Value}" />

                        <TextBlock Grid.Row="17" Grid.Column="0" Classes="org-label" Text="ОКФС" />
                        <TextBox Grid.Row="17" Grid.Column="1" Classes="org-field" Text="{Binding Storage.Rows10[1].Okfs.Value}" />

                    </Grid>
                </Border>

                <!--#endregion Территориальное обособленное подразделение-->

            </StackPanel>
        </ScrollViewer>

        <!--#endregion ScrollViewer-->

    </Grid>
</Window>
