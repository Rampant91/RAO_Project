<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Messages"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        xmlns:converter="clr-namespace:Client_App.VisualRealization.Converters"
        mc:Ignorable="d"
        x:Class="Client_App.Views.Messages.AskListOfOrgsPeriodMessageWindow"
        x:CompileBindings="True"
        x:DataType="vm:AskListOfOrgsPeriodMessageVM"
        Title="Фильтр по периоду"
        MinWidth="460" MinHeight="280"
        d:DesignWidth="460" d:DesignHeight="280"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.25" behaviors:WindowScreenSizeBehavior.HeightRatio="0.25"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Window.Resources>
        <converter:DateConverter x:Key="DateConverter"/>
    </Window.Resources>

    <Design.DataContext>
        <vm:AskListOfOrgsPeriodMessageVM/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
          Margin="15">

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="Укажите период фильтрации отчётов. Пустые поля означают отсутствие ограничения. Если все поля пустые — выгрузка без фильтра."/>

        <!-- Формы 1: даты -->
        <TextBlock Grid.Row="1"
                   Margin="0,5,0,3"
                   FontWeight="SemiBold"
                   Text="Формы 1 (период дат):"/>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto,*,Auto"
              Margin="0,0,0,10">
            <TextBox Grid.Column="0"
                     Watermark="дд.мм.гггг"
                     Text="{Binding Form1StartDate, Mode=TwoWay}"/>
            <CalendarDatePicker Grid.Column="1"
                                Classes="buttonOnly"
                                Margin="2,0,0,0"
                                SelectedDate="{ReflectionBinding Form1StartDate, Mode=TwoWay, Converter={StaticResource DateConverter}}"/>
            <TextBlock Grid.Column="2"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Text="－"/>
            <TextBox Grid.Column="3"
                     Watermark="дд.мм.гггг"
                     Text="{Binding Form1EndDate, Mode=TwoWay}"/>
            <CalendarDatePicker Grid.Column="4"
                                Classes="buttonOnly"
                                Margin="2,0,0,0"
                                SelectedDate="{ReflectionBinding Form1EndDate, Mode=TwoWay, Converter={StaticResource DateConverter}}"/>
        </Grid>

        <!-- Формы 2: годы -->
        <TextBlock Grid.Row="3"
                   Margin="0,5,0,3"
                   FontWeight="SemiBold"
                   Text="Формы 2 (период годов):"/>

        <Grid Grid.Row="4"
              ColumnDefinitions="*,Auto,*"
              Margin="0,0,0,15">
            <TextBox Grid.Column="0"
                     Watermark="гггг"
                     MaxLength="4"
                     Text="{Binding Form2StartYear, Mode=TwoWay}"/>
            <TextBlock Grid.Column="1"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Text="－"/>
            <TextBox Grid.Column="2"
                     Watermark="гггг"
                     MaxLength="4"
                     Text="{Binding Form2EndYear, Mode=TwoWay}"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,10">
            <Button Click="OnOkButtonClicked"
                    Content="Ок"
                    IsDefault="True"
                    HorizontalContentAlignment="Center"
                    Width="90"
                    Margin="0,0,15,0"/>
            <Button Click="OnCancelButtonClicked"
                    Content="Отмена"
                    IsCancel="True"
                    HorizontalContentAlignment="Center"
                    Width="90"/>
        </StackPanel>
    </Grid>
</Window>
