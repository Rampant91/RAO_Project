<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Messages"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        mc:Ignorable="d"
        x:Class="Client_App.Views.Messages.NetworkUpdateNotificationWindow"
        x:CompileBindings="True"
        x:DataType="vm:NetworkUpdateNotificationVM"
        Title="Обновление ПО МПЗФ (отдел)"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.32" behaviors:WindowScreenSizeBehavior.HeightRatio="0.4"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="White">

    <Design.DataContext>
        <vm:NetworkUpdateNotificationVM/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0"
                   Text="Доступна новая версия для отдела"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#1565C0"
                   Margin="20,20,20,15"/>

        <StackPanel Grid.Row="1" Margin="20,0,20,10">
            <Border Background="#E3F2FD"
                    CornerRadius="8"
                    Padding="15"
                    BorderBrush="#90CAF9"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Версия:" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding VersionLabel, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1565C0"
                               Margin="10,5,0,0"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Дата публикации:" FontWeight="Bold" FontSize="14" Margin="0,15,0,0"/>
                    <TextBlock Text="{Binding PublishedAtText, Mode=OneWay}" FontSize="14" Margin="10,5,0,0"/>

                    <TextBlock Text="У вас сейчас:" FontWeight="Bold" FontSize="14" Margin="0,15,0,0"/>
                    <TextBlock Text="{Binding CurrentReleaseLabel, Mode=OneWay}"
                               FontSize="14"
                               Margin="10,5,0,0"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Release.Notes, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Margin="0,15,0,0"
                       FontSize="13"
                       Opacity="0.85"/>

            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       FontSize="13"
                       Foreground="#E65100"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">
            <Button Content="Обновить сейчас"
                    Command="{Binding UpdateNowCommand, Mode=OneWay}"
                    Background="#1976D2"
                    Foreground="White"
                    Width="150"
                    Height="40"
                    Margin="0,0,10,0"
                    FontSize="13"
                    FontWeight="Medium"/>
            <Button Content="Напомнить позже"
                    Command="{Binding RemindLaterCommand, Mode=OneWay}"
                    Background="#FF9800"
                    Foreground="White"
                    Width="150"
                    Height="40"
                    Margin="0,0,10,0"
                    FontSize="13"
                    FontWeight="Medium"/>
            <Button Content="Пропустить версию"
                    Command="{Binding SkipReleaseCommand, Mode=OneWay}"
                    IsVisible="{Binding CanSkip, Mode=OneWay}"
                    Background="#757575"
                    Foreground="White"
                    Width="150"
                    Height="40"
                    FontSize="13"
                    FontWeight="Medium"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="Файлы будут скопированы автоматически, программа перезапустится."
                   FontSize="11"
                   Opacity="0.6"
                   HorizontalAlignment="Center"
                   Margin="20,0,20,16"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
