<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	         xmlns:interactivity="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
			 xmlns:behaviors="using:Client_App.Behaviors"
			 xmlns:inputBehaviors="using:Client_App.Behaviors.Input"
			 xmlns:controlBehaviors="using:Client_App.Behaviors.Controls"
             xmlns:local="using:Client_App"
             xmlns:resources="clr-namespace:Client_App.Resources"
             xmlns:converters="clr-namespace:Client_App.Converters"
             xmlns:visualConverters="clr-namespace:Client_App.VisualRealization.Converters"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             x:Class="Client_App.App">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <resources:RatioConverter x:Key="RatioConverter"/>
        <converters:StringToDateTimeConverter x:Key="StringToDateTimeConverter"/>
        <visualConverters:ShortNullableToStringConverter x:Key="ShortNullableToStringConverter"/>
        <visualConverters:ByteNullableToStringConverter x:Key="ByteNullableToStringConverter"/>
        <visualConverters:ByteNullableOrDashToStringConverter x:Key="ByteNullableOrDashToStringConverter"/>
        <visualConverters:FrozenOperationHeaderColSpanConverter x:Key="FrozenOperationHeaderColSpanConverter"/>
        <!--
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type vm:CheckFormVM}">
                <v:CheckForm/>
            </DataTemplate>
        </ResourceDictionary>
        -->
        <!--Палитра-->
        <SolidColorBrush x:Key="PrimaryColor" Color="#99d3f0"/>

    </Application.Resources>


    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <Style Selector="DataGridCell.cell_tooltip">
            <Setter Property="ToolTip.Tip" Value="{Binding Content.Text, Mode=OneWay, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style Selector="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid
                        RowDefinitions="Auto,*"
                        ColumnDefinitions="Auto,*">

                        <!-- Header -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            ZIndex="1"
                            Background="White"
                            Padding="5,0,5,0"
                            Margin="5,0,0,0">
                            <TextBlock
                                Text="{TemplateBinding Header}"
                                FontWeight="Bold"/>
                        </Border>

                        <!-- Content Area -->
                        <Border
                            Grid.Row="0" Grid.RowSpan="2"
                            Padding="0,5,0,0"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            CornerRadius="4"
                            Margin="0,10,0,0"
                            BorderBrush="Black"
                            
                            BorderThickness="1">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Padding="8"
                                Content="{TemplateBinding Content}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
		
	    <!--Общие стили-->
		
			<!--Из-за особенностей предметной области допускается, что пользователи могут ввести вместо даты строку
			    Поэтому buttonOnly предназначен для использвания в связки с другим текстбоксом -->
        <Style Selector="CalendarDatePicker.buttonOnly TextBox">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
		<Style Selector="CalendarDatePicker.buttonOnly">
			<Setter Property="controlBehaviors:ScrollBlock.BlockPointerWheel" Value="True"/>
		</Style>
		<Style Selector="Border#Background">
			<Setter Property="Background" Value="#f0f8ff"/>
        </Style>
		<Style Selector="TextBox">
			<Setter Property="inputBehaviors:TextBoxAutoTrim.IsEnabled" Value="True"/>
		</Style>
		<Style Selector="Button">
			<Setter Property="IsTabStop" Value="False"/>
		</Style>

		<Style Selector="Expander ToggleButton">
			<Setter Property="IsTabStop" Value="False"/>
			<Setter Property="Focusable" Value="False"/>
		</Style>
		
		<Style Selector="TextBox">
			<Setter Property="behaviors:TextBoxAutoTrim.IsEnabled" Value="True"/>
		</Style>
        <!--Стили для окон редактирования форм-->
        <!--Header-->
        <Style Selector="CheckBox.hideButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="WrapPanel.header">
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>
        <Style Selector="WrapPanel.header Border.borderContainer">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Border.borderContainer TextBox">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="WrapPanel.header Button">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <!--TableHeader-->
        <Style Selector="ScrollViewer.tableScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="Grid.tableHeader">
            <Setter Property="Margin" Value="6,5,-5,5"/>
            <Setter Property="Background" Value="#f5f5f5"/>
        </Style>
        <Style Selector="Grid.tableHeader Border">
            <Setter Property="Margin" Value="-1,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#aaaaaa"/>
        </Style>
        <Style Selector="Grid.tableHeader TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
        </Style>
        <Style Selector="Grid.tableHeader Border.frozenOperationHeader TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <!--Table-->
        <Style Selector="DataGrid.table">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="5,-5,5,5"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="ColumnWidth" Value="125" />
            <Setter Property="MinColumnWidth" Value="30" />
            <Setter Property="MaxColumnWidth" Value="500" />
            <Setter Property="FontSize" Value="13"/>
        </Style>
		
		<Style Selector="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
		
		<Style Selector="Border.headerTemplate">
			<Setter Property="BorderThickness" Value="0"/>
		    <Setter Property="BorderBrush" Value="Transparent"/>
		    <Setter Property="Margin" Value="0"/>
		    <Setter Property="HorizontalAlignment" Value="Stretch"/>
		    <Setter Property="VerticalAlignment" Value="Stretch"/>
		</Style>
		
		<Style Selector="Border.headerTemplate TextBlock">
			<Setter Property="TextAlignment" Value="Center"/>
		    <Setter Property="VerticalAlignment" Value="Center"/>
		    <Setter Property="HorizontalAlignment" Value="Stretch"/>
		    <Setter Property="Margin" Value="2,2"/>
			<Setter Property="TextWrapping" Value="NoWrap"/>
		</Style>
		
		<Style Selector="Border.headerTemplate Button">
            <Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Content" Value="˅"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,2,5,2"/>
			<Setter Property="Background" Value="#f0f8ff"/>
		</Style>
		<Style Selector="DataGrid DataGridRow:selected DataGridCell">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Foreground" Value="Black"/>
		    <Setter Property="Background" Value="LightBlue"/>
        </Style>
        <Style Selector="DataGrid DataGridRow:pointerover:not(:selected) DataGridCell">
            <Setter Property="Foreground" Value="Black"/>
		    <Setter Property="Background" Value="LightGray"/>
        </Style>
		<Style Selector="DataGrid TextBox">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="DataGrid AutoCompleteBox">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		
        <Style Selector="DataGrid.table TextBox">
            <Setter Property="Margin" Value="-1,-1,-1,-1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
		</Style>
        <Style Selector="DataGrid.table CalendarDatePicker">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="2,-1,-1,-2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Watermark" Value="&lt;дд.мм.гггг&gt;"/>
        </Style>
		
        <!--PageControl-->
        <Style Selector="Border.pageControlContainer">
			<Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
		<Style Selector="Border.pageControlContainer TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.pageControlContainer NumericUpDown">
			<Setter Property="CornerRadius" Value="5"/>
		</Style>

        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Panel#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
		
        <!--Notes-->
		<Style Selector="Border.notesContainer">
			<Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Margin" Value="5"/>
		</Style>
        <Style Selector="Border.notesContainer StackPanel">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="DataGrid.notesTable">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="MaxHeight" Value="210"/>
			<Setter Property="Height" Value="210"/>
			<Setter Property="ColumnHeaderHeight" Value="25"/>
            <Setter Property="RowBackground" Value="White"/>
			<Setter Property="Background" Value="LightGray"/>
			<Setter Property="SelectionMode" Value="Extended"/>
			<Setter Property="CanUserResizeColumns" Value="True"/>
            
            <Setter Property="Margin" Value="5"/>
			<Setter Property="GridLinesVisibility" Value="All"></Setter>
        </Style>

		<Style Selector="DataGrid.notesTable DataGridColumnHeader">
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
	    </Style>
		<Style Selector="DataGrid.notesTable TextBox">
			<Setter Property="BorderThickness" Value="0.5"/>
			<Setter Property="Margin" Value="0,0,0,0"/>
			<Setter Property="MinHeight" Value="25"/>
			<Setter Property="MaxHeight" Value="100"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
		</Style>
        <!--Конец стилей для окон редактирования форм-->
		<!--Другие стили-->
		<Style Selector="DataGrid DataGridRow DataGridCell TextBlock.readOnly">
			<Setter Property="Background" Value="#ededed"/>
			<Setter Property="Foreground" Value="#93140e"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0,5,0,0"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>
		<Style Selector="DataGrid DataGridRow:pointerover:not(:selected) DataGridCell TextBlock.readOnly">
			<Setter Property="Background" Value="#b5b5b5"/>
			<Setter Property="Foreground" Value="#93140e"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0,5,0,0"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>
		<Style Selector="DataGrid DataGridRow:selected DataGridCell TextBlock.readOnly">
			<Setter Property="Background" Value="#86c4d9"/>
			<Setter Property="Foreground" Value="#93140e"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0,5,0,0"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>

		<Style Selector="AutoCompleteBox.hitable">
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>
		<Style Selector="AutoCompleteBox.hitable TextBox">
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>

		<!-- Legacy DataGrid: плоские ячейки как Excel, ошибка — иконка внутри -->
		<Style Selector="TextBox.legacy-dg-cell">
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="2,0,14,0"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBox.legacy-dg-cell /template/ DataValidationErrors">
			<Setter Property="Theme" Value="{StaticResource TooltipDataValidationErrors}"/>
		</Style>
		<Style Selector="TextBox.legacy-dg-cell /template/ DataValidationErrors /template/ ContentControl">
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,1,0"/>
			<Setter Property="ZIndex" Value="2"/>
		</Style>

		<Style Selector="ScrollViewer.legacy-dg-scroll">
			<Setter Property="AllowAutoHide" Value="False"/>
		</Style>

        <Style Selector="DataGrid.dbPicker">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Styles>
</Application>