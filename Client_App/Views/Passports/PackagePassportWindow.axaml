<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:passports="clr-namespace:Models.Passports;assembly=Models"
        xmlns:interactivity="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
		xmlns:converter="clr-namespace:Client_App.VisualRealization.Converters"
        xmlns:local="using:Client_App.Behaviors"
		xmlns:vm="using:Client_App.ViewModels.Passports"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="690" MinHeight="300"
        x:Class="Client_App.PackagePassportWindow"
        x:DataType="vm:PackagePassportWindowVM"
		x:Name="PackagePassportWindow"
        Title="PackagePassportWindow">

	<Window.Resources>
		<converter:DoubleToExponentionalFormatConvarter x:Key="ExpontionalFormatConverter"/>
		<converter:DateToStringConverter x:Key="DateToStringConverter"/>
		<converter:LogicalNotConverter x:Key="LogicalNotConverter"/>
	</Window.Resources>

	<Design.DataContext>				   
		<vm:PackagePassportWindowVM/>
	</Design.DataContext>
        
	<Grid RowDefinitions="Auto, *"
		  >
	<Menu Grid.Row="0" 
		  x:Name="SubMenuBorder" 
		  BorderBrush="#FF959595" 
		  BorderThickness="1" 
		  Background="WhiteSmoke"
		  Height="25"
		  DockPanel.Dock="Top">

			<Menu.Styles>
				<Style Selector="Separator">
					<Setter Property="Background" Value="LightGray"/>
					<Setter Property="Margin" Value="0,5"/>
					<Setter Property="Height" Value="3"/>
				</Style>
				<Style Selector="MenuItem">
					<Setter Property="Background" Value="WhiteSmoke"/>
					<Setter Property="FontSize" Value="14"/>
				</Style>
			</Menu.Styles>
			<MenuItem Header="Файл">
					<MenuItem Header="Сохранить"
							  Command="{Binding SavePassport}"/>
			</MenuItem>
		</Menu>
		<ScrollViewer Grid.Row ="1"
					  VerticalScrollBarVisibility="Auto">

			<Grid ColumnDefinitions="*">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*" MinHeight="175" />
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

			

				<!--Header-->

				<StackPanel Grid.Row="0" HorizontalAlignment="Center">
					<TextBlock Margin="5"
							   FontWeight="Bold"
							   FontSize="18"
							   Text="ПАСПОРТ"
							   TextAlignment="Center"/>
					<TextBlock Margin="5"
							   FontWeight="Bold"
							   FontSize="14"
							   Text="на упаковку твердых радиоактивных отходов"
							   TextAlignment="Center"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
						<TextBlock Margin="5"
								   FontWeight="Bold"
								   Text="№"/>
						<TextBox Margin="5"
								 MinWidth="150"
								 Text="{Binding Passport.PassportNum}"
								 Watermark="(паспорта)"/>
						<TextBlock Margin="5"
								   FontWeight="Bold"
								   Text="от"/>
						<TextBox Margin="5"
								 MinWidth="150"
								 Text="{Binding Passport.PassportDate, Converter={StaticResource DateToStringConverter}}"
								 Watermark="(дата)"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<TextBlock Margin="5"
								   FontWeight="Bold"
								   Text="Наименование"/>
						<TextBox Margin="5"
								 MinWidth="300"
								 Text="{Binding Passport.PackageType}"
								 Watermark="(тип упаковки РАО, неупакованных РАО)"/>
					</StackPanel>

				</StackPanel>

				<Expander
					Margin="5"
					Grid.Row="1"
					Header="Основная информация"
					IsExpanded="True">
					<Grid
						MaxWidth="1500"
						MinWidth="670"
						RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
						ColumnDefinitions="*,*,*,*">

						<StackPanel Grid.Row="0" Grid.Column="0"
									Orientation="Horizontal" HorizontalAlignment="Right">
							<TextBlock Margin="5"
								Text="Код &quot;Статус РАО&quot; -"/>

							<TextBox Width="50" Margin="5"
								 Text="{Binding Passport.StatusRaoCode}"/>
						</StackPanel>

						<TextBox Grid.Row="0" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.TechSpecification}"
								 Watermark="(номер технических условий)"/>
						<TextBox Grid.Row="0" Grid.Column="2" Margin="5"
								 Text="{Binding Passport.NameRao}"
								 Watermark="(название РАО)"/>
						<TextBox Grid.Row="0" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.ClassRao}"
								 Watermark="(класс РАО)"/>

						<TextBlock Grid.Row="1" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Номер договора передачи РАО на захоронение"/>
						<TextBox Grid.Row="1" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.RaoDisposalNum}"/>
						<TextBox Grid.Row="1" Grid.Column="2" Margin="5"
								 Text="{Binding Passport.RaoDisposalDate, Converter={StaticResource DateToStringConverter}}"/>

						<TextBlock Grid.Row="2" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Индивидуальный номер упаковки РАО"/>
						<TextBox Grid.Row="2" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.PackageIdCode}"
								   Watermark="(Идентификационный код)"/>
						<TextBox Grid.Row="2" Grid.Column="2" Margin="5"
								 Grid.ColumnSpan="2"
								 Text="{Binding Passport.TypeAndIdPuod}"
								 Watermark="(тип и идентификаторы ПУОД)"/>

						<TextBlock Grid.Row="3" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Организация-собственник упаковки РАО"/>
						<TextBox Grid.Row="3" Grid.Column="1" Margin="5"
								 Grid.ColumnSpan="2"
								 Text="{Binding Passport.Owner}"
								 Watermark="Название организации"/>
						<TextBox Grid.Row="3" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.OwnerOkpo}"
								 Watermark="ОКПО"/>

						<TextBlock Grid.Row="4" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Организация-изготовитель упаковки РАО"/>
						<TextBox Grid.Row="4" Grid.Column="1" Margin="5"
								 Grid.ColumnSpan="2"
								 Text="{Binding Passport.Manufacturer}"
								 Watermark="Название организации"/>
						<TextBox Grid.Row="4" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.ManufacturerOkpo}"
								 Watermark="ОКПО"/>

						<TextBlock Grid.Row="5" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Номер сертификата соответствия на контейнер (упаковочный комплект)"/>
						<TextBox Grid.Row="5" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.CertificateConformityNum}"/>


						<TextBlock Grid.Row="5" Grid.Column="2" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Дата изготовления упаковки РАО"/>
						<TextBox Grid.Row="5" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.ManufactureDate, Converter={StaticResource DateToStringConverter}}"/>

						<TextBlock Grid.Row="6" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Срок действия сертификата"/>
						<TextBox Grid.Row="6" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.CertificateConformityStartPeriod, Converter={StaticResource DateToStringConverter}}"/>
						<TextBox Grid.Row="6" Grid.Column="2" Margin="5"
								 Text="{Binding Passport.CertificateConformityEndPeriod, Converter={StaticResource DateToStringConverter}}"/>

						<TextBlock Grid.Row="7" Grid.Column="0" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Срок службы контейнера (упаковочного комплекта)"/>
						<TextBox Grid.Row="7" Grid.Column="1" Margin="5"
								 Text="{Binding Passport.ServiceLife}"/>
						<TextBlock Grid.Row="7" Grid.Column="2" Margin="5"
								   HorizontalAlignment="Right"
								   TextWrapping="Wrap"
								   Text="Дата передачи упаковки РАО на захоронение"/>
						<TextBox Grid.Row="7" Grid.Column="3" Margin="5"
								 Text="{Binding Passport.TransferDate, Converter={StaticResource DateToStringConverter}}"/>
					</Grid>
				</Expander>


				<!--Таблица 1-->
				<Expander
					Grid.Row="2"
					Header="Общая характеристика упаковки РАО"
					IsExpanded="True"
					Margin="5">

					<ScrollViewer Margin="5" Grid.Row="3" HorizontalScrollBarVisibility="Auto">

						<interactivity:Interaction.Behaviors>
							<local:ChainingScrollViewerBehavior/>
						</interactivity:Interaction.Behaviors>

						<Grid x:Name="Table1"
							  ColumnDefinitions="Auto"
							  RowDefinitions="Auto,Auto,Auto">

							<!--#region Заголовки таблицы-->

							<Grid Grid.Row="0"
								  Width="{Binding ElementName=dataGrid.Width}"
								  Classes="tableHeader"
								  ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
								  RowDefinitions="Auto,Auto">

								<interactivity:Interaction.Behaviors>
									<local:ColumnWidthSyncBehavior SourceDataGrid="{Binding ElementName=dataGrid1}" />
								</interactivity:Interaction.Behaviors>

								<!--Первый уровень заголовков-->

								<Border Grid.Row="0"
										Grid.Column="0"
										Grid.ColumnSpan="6"
										BorderThickness="1,1,1,0">
									<TextBlock>Состав упаковки РАО</TextBlock>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="6"
										Grid.ColumnSpan="4">
									<TextBlock>Габариты упаковки РАО, мм</TextBlock>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="10"
										Grid.ColumnSpan="2">
									<TextBlock Text="Масса, кг (объем, куб. м)"/>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="12"
										Grid.ColumnSpan="2">
									<TextBlock Text="Мощность дозы излучения,мк3в/ч на расстоянии от поверхности, м"/>
								</Border>
								<Border Grid.Row="0"
										Grid.Column="14"
										Grid.ColumnSpan="2">
									<TextBlock Text="Уровень нефиксированного загрязнения, частиц/(мин*см²)"/>
								</Border>
								<!--Третий уровень заголовков-->

								<Border Grid.Row="1" Grid.Column="0">
									<TextBlock Text="Способ размещения отходов" />
								</Border>
								<Border Grid.Row="1" Grid.Column="1">
									<TextBlock Text="Физико-химическая форма РАО, тип матричного материала"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="2">
									<TextBlock Text="Морфологический (химический состав)"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="3">
									<TextBlock Text="Горючесть"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="4">
									<TextBlock Text="Наличие и вид матричного материала"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="5">
									<TextBlock Text="Дата заполнения отходами"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="6">
									<TextBlock Text="Диаметр"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="7">
									<TextBlock Text="Высота"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="8">
									<TextBlock Text="Длина"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="9">
									<TextBlock Text="Ширина"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="10">
									<TextBlock Text="Упаковки РАО"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="11">
									<TextBlock Text="РАО в упаковке"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="12">
									<TextBlock Text="0,1"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="13">
									<TextBlock Text="1"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="14">
									<TextBlock Text="альфа"/>
								</Border>
								<Border Grid.Row="1" Grid.Column="15">
									<TextBlock Text="бета/гамма"/>
								</Border>
								<Border Grid.Row="0" Grid.Column="16"
										Grid.RowSpan="2">
									<TextBlock Text="Тепловыделение, Вт/м³, Вт/упаковку"/>
								</Border>

							</Grid>


							<!--#region DataGrid-->

							<DataGrid x:Name="dataGrid1"
									  Grid.Row="1"
									  CornerRadius="5"
									  CanUserResizeColumns="True"
									  RowBackground="White"
									  AlternatingRowBackground="White"
									  SelectionMode ="Single"
									  Margin="5,-5,5,5"
									  x:CompileBindings="True"
									  CanUserReorderColumns="False"
									  CanUserSortColumns="True"
									  Classes="table"
									  ColumnWidth="150"
									  MaxColumnWidth="500">


								<DataGrid.Columns>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="1" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="2" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="3" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="4" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="5" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="6" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="7" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="8" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="9" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="10" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="11" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="12" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="13" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="14" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="15" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="16" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn>
										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<Border Classes="headerTemplate">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Grid.Column="0" Text="17" />
													</Grid>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>


								</DataGrid.Columns>
							</DataGrid>
							<Grid Grid.Row="2"
								  Margin="6,-5,0,0"
								Classes="tableHeader"
								Width="{Binding ElementName=dataGrid.Width}"
								ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<interactivity:Interaction.Behaviors>
									<local:ColumnWidthSyncBehavior SourceDataGrid="{Binding ElementName=dataGrid1}" />
								</interactivity:Interaction.Behaviors>

								<Border Grid.Row="0" Grid.Column="0">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.DisposalMethod}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="1">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.PhysicochemicalForm}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="2">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.MorphologicalComposition}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="3">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.Flammability}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="4">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.MatrixMaterialType}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="5">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.FillingWasteDate, Converter={StaticResource DateToStringConverter}}"/>
								</Border>
								<Border Grid.Row="0" Grid.Column="6">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.Diameter}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="7">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.Height}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="8">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.Length}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="9">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.Width}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="10">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.PackageMass}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="11">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.RaoMass}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="12">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.PackageVolume}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="13">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.RaoVolume}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="14">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.RadiationDoseRate1m}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="15">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.RadiationDoseRate10cm}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="16">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.LevelNonFixedPollutionAlpha}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="17">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.LevelNonFixedPollutionBetaGamma}" />
								</Border>
								<Border Grid.Row="0" Grid.Column="18">
									<TextBox
										TextWrapping="Wrap"
										AcceptsReturn="True"
										Text="{Binding Passport.HeatOutput}" />
								</Border>
							</Grid>
						</Grid>
					</ScrollViewer>
				</Expander>
				<!--Таблица 2-->

				<Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto">
					<TextBlock Grid.Row="0"
							 FontWeight="Bold"
							 TextAlignment="Center"
							 Text ="{Binding Passport.ContentCharacteristics[0].LongLivingActivity}"/>
					<TextBlock Grid.Row="1"
							 FontWeight="Bold"
							 TextAlignment="Center"
							 Text ="{Binding Passport.ContentCharacteristics[0].TransuraniumActivity}"/>
					
				</Grid>

				<ScrollViewer Margin="5" Grid.Row="4" HorizontalScrollBarVisibility="Auto" 
							Height="600">

					<interactivity:Interaction.Behaviors>
						<local:ChainingScrollViewerBehavior/>
					</interactivity:Interaction.Behaviors>

					<Grid x:Name="Table2"
						  ColumnDefinitions="Auto"
						  RowDefinitions="Auto,*">

						<!--#region Контекстное меню-->

						<Grid.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Добавить первичную упаковку" 
										  Command="{Binding AddPrimaryPackage}"/>
								<MenuItem Header="Удалить первичную упаковку" 
										  Command="{Binding DeletePrimaryPackage}" 
										  CommandParameter="{Binding SelectedCharacteristic}"/>
							</ContextMenu>
						</Grid.ContextMenu>

						<!--#endregion Контекстное меню-->

						<!--#region Заголовки таблицы-->

						<Grid Grid.Row="0"
							  Width="{Binding ElementName=dataGrid.Width}"
							  Classes="tableHeader"
							  ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
							  RowDefinitions="Auto,Auto,Auto">

							<interactivity:Interaction.Behaviors>
								<local:ColumnWidthSyncBehavior SourceDataGrid="{Binding ElementName=dataGrid2}" />
							</interactivity:Interaction.Behaviors>

							<!--Первый уровень заголовков-->
							<Border Grid.Row="0" Grid.Column="8"
									Grid.ColumnSpan="5">
								<TextBlock Text="Суммарные удельные активности, кБк/кг"/>
							</Border>
							<!--Второй уровень заголовков-->
							<Border Grid.Row="0" Grid.Column="0"
									Grid.RowSpan="2">
								<TextBlock Text="Индивидуальный номер упаковки"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="1"
									Grid.RowSpan="2">
								<TextBlock Text="Класс"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="2"
									Grid.RowSpan="2">
								<TextBlock Text="Код"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="3"
									Grid.RowSpan="2">
								<TextBlock Text="Количество, шт."/>
							</Border>
							<Border Grid.Row="0" Grid.Column="4"
									Grid.RowSpan="2">
								<TextBlock Text="Объем, м³"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="5"
									Grid.RowSpan="2">
								<TextBlock Text="Масса с отходами, кг"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="6"
									Grid.RowSpan="2">
								<TextBlock Text="Радионуклидный состав"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="7"
									Grid.RowSpan="2">
								<TextBlock Text="Удельная активность, кБк/кг"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="8">
								<TextBlock Text="долгоживущие"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="9">
								<TextBlock Text="трансурановые"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="10">
								<TextBlock Text="альфа-изл. (за искл. т/уран.)"/>
							</Border>
							<Border Grid.Row="1" Grid.Column="11">
								<TextBlock Text="бета/гамма- изл."/>
							</Border>
							<Border Grid.Row="1" Grid.Column="12">
								<TextBlock Text="тритий"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="13"
									Grid.RowSpan="2">
								<TextBlock Text="Общая активность, Бк"/>
							</Border>
							<Border Grid.Row="0" Grid.Column="14"
									Grid.RowSpan="2">
								<TextBlock Text="Содержание ядерно-опасных делящихся нуклидов, г"/>
							</Border>

						</Grid>


						<!--#region DataGrid-->

						<DataGrid
							x:Name="dataGrid2"
							Classes="table"
							Grid.Row="1"
							CornerRadius="5"
							CanUserResizeColumns="True"
							RowBackground="White"
							AlternatingRowBackground="White"
							SelectionMode ="Single"
							Margin="5,-5,5,5"
							x:CompileBindings="True"
							CanUserSortColumns="True"
							CanUserReorderColumns="False"
							Items="{Binding Passport.ContentCharacteristics}"
							SelectedItem="{Binding SelectedCharacteristic}"
							ColumnWidth="125"
							VerticalScrollBarVisibility="Disabled">
						
							<interactivity:Interaction.Behaviors>
								<local:DataGridPointerBehavior />
								<local:DeselectDataGridOnClickOutsideBehavior />
							</interactivity:Interaction.Behaviors>

							<DataGrid.Columns>
								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="1" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PackageIdNum, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="2" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding ClassRao, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="3" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding CodeRao, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="4" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PrimaryPackageQuantity, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="5" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PrimaryPackageVolume, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="6" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding PrimaryPackageMass, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="7" />
													<CheckBox Grid.Column="1"
															  IsChecked ="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow}"
															  Content="Альт. запись"/>
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<Grid RowDefinitions="Auto, *">
												<StackPanel 
													Grid.Row="0"
														IsEnabled="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow, Converter={StaticResource LogicalNotConverter}}"
														IsVisible="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow, Converter={StaticResource LogicalNotConverter}}">
													<ListBox 
														MaxHeight="240" 
														Items="{Binding RadionuclidsList}" 
														Background="Transparent" 
														SelectionMode="Single">
														<ListBox.ItemTemplate>
															<DataTemplate x:DataType="passports:Radionuclid">
																<Grid ColumnDefinitions="*,Auto">
																	<AutoCompleteBox 
																		Classes="hitable"
																		Grid.Column="0"
																		Background="White"
																		Height="26"
																		FilterMode="Contains"
																		Items="{Binding VM.RaoNamesCollection, ElementName=PackagePassportWindow}"
																		Text="{Binding Name}">
																	</AutoCompleteBox>
																	<Button Grid.Column="1"
																			IsHitTestVisible="True"
																			Content="X"
																			Width="26"
																			Height="26"
																			Command="{Binding VM.DeleteRadionuclid, ElementName=PackagePassportWindow}"
																			CommandParameter="{Binding}"/>
																</Grid>
															</DataTemplate>
														</ListBox.ItemTemplate>
													</ListBox>
													<Button	
														Content="Добавить"
														Command="{Binding VM.AddRadionuclid, ElementName=PackagePassportWindow}"
														CommandParameter="{Binding}"/>
												</StackPanel>

												<TextBox 
													Grid.Row="1"
													IsEnabled="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow}"
													IsVisible="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow}"
													Text="{Binding RadionuclidsComposition, Mode=TwoWay}"/>
												
											</Grid>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="8" />
													<CheckBox Grid.Column="1"
															  IsChecked ="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow}"
															  Content="Альт. запись"/>
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<Grid RowDefinitions="Auto,*">
												<StackPanel 
														IsEnabled="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow, Converter={StaticResource LogicalNotConverter}}"
														IsVisible="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow, Converter={StaticResource LogicalNotConverter}}">
													<ListBox
														MaxHeight="240"
														Items="{Binding RadionuclidsList}"
														Background="Transparent"
														SelectionMode="Single">
														<ListBox.ItemTemplate>
															<DataTemplate x:DataType="passports:Radionuclid">
																<Grid ColumnDefinitions="*,Auto">
																	<TextBox Grid.Column="0"
																			 Height="26"
																			 Background="White"
																			 IsHitTestVisible="True"
																			 Text="{Binding Activity, Converter={StaticResource ExpontionalFormatConverter}}"/>
																	<Button Grid.Column="1"
																			IsHitTestVisible="True"
																			Content="X"
																			Width="26"
																			Height="26"
																			Command="{Binding VM.DeleteRadionuclid, ElementName=PackagePassportWindow}"
																			CommandParameter="{Binding}"/>
																</Grid>
															</DataTemplate>
														</ListBox.ItemTemplate>
													</ListBox>
													<Button 
														Content="Добавить"
															Command="{Binding VM.AddRadionuclid, ElementName=PackagePassportWindow}"
															CommandParameter="{Binding}"/>
												</StackPanel>

												<TextBox
													Grid.Row="1" 
													IsEnabled="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow}"
													IsVisible="{Binding VM.RadionuclidViewSwitch, ElementName=PackagePassportWindow}"
													Text="{Binding RadionuclidsActivity, Mode=TwoWay}"/>
												
											</Grid>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="9" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding LongLivingActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="10" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding TransuraniumActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="11" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding AlphaActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="12" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding BetaGammaActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="13" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding TritiumActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="14" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding TotalActivity, Mode=TwoWay, Converter={StaticResource ExpontionalFormatConverter}}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<DataGridTemplateColumn>
									<DataGridTemplateColumn.HeaderTemplate>
										<DataTemplate>
											<Border Classes="headerTemplate">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="15" />
												</Grid>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.HeaderTemplate>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="passports:CharacteristicPrimaryPackage">
											<TextBox Text="{Binding NuclearHazardousFissileNuclides, Mode=TwoWay}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>

					</Grid>
				</ScrollViewer>

				<TextBox Grid.Row="5"
						 AcceptsReturn="True"
						 Margin="5"
						 MaxWidth="1500"
						 Text="{Binding Passport.Notes}"
						 Watermark ="Примечания"
						 TextWrapping="Wrap"/>
			
				<!--Footer-->
				<Grid Grid.Row="6"
					  Margin="5"
					  MaxWidth="1500"
					  RowDefinitions="Auto, Auto"
					  ColumnDefinitions="Auto, *, *, *, *">
					<TextBlock Grid.Row="0" Grid.Column="0" Margin="5"
							   HorizontalAlignment="Right"
							   Text="Ответственный за сдачу РАО"/>
					<TextBox Grid.Row="0" Grid.Column="1" Margin="5"
							 Text="{Binding Passport.ResponsibleTransfer}"
							 Watermark="(наименование организации)"/>
					<TextBox Grid.Row="0" Grid.Column="2" Margin="5"
							 Text="{Binding Passport.GradeAuthorizedPersonTransfer}"
							 Watermark="(Должность уполномоченного лица)"/>
					<TextBox Grid.Row="0" Grid.Column="3" Margin="5"
							 Text="{Binding Passport.FioAuthorizedPersonTransfer}"
							 Watermark="(Фамилия И.О. уполномоченного лица)"/>
					<TextBox Grid.Row="0" Grid.Column="4" Margin="5"
							 Watermark="(подпись уполномоченного лица)"/>

					<TextBlock Grid.Row="1" Grid.Column="0" Margin="5"
							   HorizontalAlignment="Right"
							   Text="Ответственный за прием РАО"/>
					<TextBox Grid.Row="1" Grid.Column="1" Margin="5"
							 Text="{Binding Passport.ResponsibleReception}"
							 Watermark="(наименование организации)"/>
					<TextBox Grid.Row="1" Grid.Column="2" Margin="5"
							 Text="{Binding Passport.GradeAuthorizedPersonReception}"
							 Watermark="(Должность уполномоченного лица)"/>
					<TextBox Grid.Row="1" Grid.Column="3" Margin="5"
							 Text="{Binding Passport.FioAuthorizedPersonReception}"
							 Watermark="(Фамилия И.О. уполномоченного лица)"/>
					<TextBox Grid.Row="1" Grid.Column="4" Margin="5"
							 Watermark="(подпись уполномоченного лица)"/>
				</Grid>
			</Grid>
		</ScrollViewer>
	</Grid>
</Window>