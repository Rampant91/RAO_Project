<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Messages"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.5" behaviors:WindowScreenSizeBehavior.HeightRatio="0.65"
        x:Class="Client_App.Views.Messages.SkippedIdenticalReportsMessageWindow"
        Title="Импорт из .raodb/.xlsx/.json"
        WindowStartupLocation="CenterOwner"
        MinWidth="640" MinHeight="360">

    <Design.DataContext>
        <vm:SkippedIdenticalReportsMessageWindowVM/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <TextBlock Grid.Row="0"
                   Text="{Binding HeaderTitle}"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <Border IsVisible="{Binding HasImportedReports}"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ImportedSummaryMessage}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>
                        <DataGrid x:Name="ImportedReportsGrid"
                                  Items="{Binding ImportedReports}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  RowBackground="White"
                                  AlternatingRowBackground="#DDEBF7"
                                  MaxHeight="250"/>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding HasSkippedReports}"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding SkippedSummaryMessage}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>
                        <DataGrid x:Name="SkippedReportsGrid"
                                  Items="{Binding SkippedReports}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  RowBackground="White"
                                  AlternatingRowBackground="#DDEBF7"
                                  MaxHeight="250"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Ок"
                    IsDefault="True"
                    Click="OnOkClicked"
                    Width="80"/>
        </StackPanel>
    </Grid>
</Window>
