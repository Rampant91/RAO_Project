<UserControl
    x:Class="Client_App.Views.MainWindowTabs.Forms5TabControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Client_App.Views.Controls"
    xmlns:converter="clr-namespace:Client_App.VisualRealization.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:local="using:Client_App.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Models.Collections;assembly=Models"
    xmlns:vm="using:Client_App.ViewModels.MainWindowTabs"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:Forms5TabControlVM"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converter:IfNullShowAnotherValue x:Key="IfNullShowAnotherValue" />
        <converter:StringEqualsToColorConverter x:Key="StringEqualsToColor" />
    </UserControl.Resources>

    <Design.DataContext>
        <vm:Forms5TabControlVM />
    </Design.DataContext>

    <Border Classes="borderContainer">
        <Grid ColumnDefinitions="5*,3*" RowDefinitions="*,*">
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                RowDefinitions="Auto,*,Auto">
                <TextBox
                    Grid.Row="0"
                    Margin="5"
                    Text="{Binding SearchText, Mode=OneWayToSource}"
                    Watermark="Поиск..." />
                <!--  Ошибка в этом DataGrid  -->
                <DataGrid
                    Grid.Row="1"
                    Margin="5"
                    AlternatingRowBackground="White"
                    CanUserSortColumns="False"
                    GridLinesVisibility="All"
                    Items="{Binding ReportsCollection, Mode=TwoWay}"
                    RowBackground="White"
                    RowHeight="25"
                    SelectedItem="{Binding SelectedReports, Mode=TwoWay}"
                    SelectionMode="Single">

                    <interactivity:Interaction.Behaviors>
                        <local:DataGridDoubleClickOpenBehavior />
                    </interactivity:Interaction.Behaviors>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding MainWindowVM.AddReports, Mode=OneWay}" Header="Добавить форму" />
                            <MenuItem Command="{Binding MainWindowVM.NewChangeReports, Mode=OneWay}" Header="Редактировать форму" />
                            <MenuItem
                                Command="{Binding MainWindowVM.ExportReports, Mode=OneWay}"
                                CommandParameter="{Binding SelectedReports, Mode=OneWay}"
                                Header="Выгрузить организацию" />
                            <MenuItem
                                Command="{Binding MainWindowVM.ExportReportsWithDateRange, Mode=OneWay}"
                                CommandParameter="{Binding SelectedReports, Mode=OneWay}"
                                Header="Выгрузить организацию с указанием диапазона дат" />
                            <MenuItem Command="{Binding MainWindowVM.ExportAllReportsOneFile, Mode=OneWay}" Header="Выгрузить все организации в один файл" />
                            <MenuItem
                                Command="{Binding MainWindowVM.ExportAllReports, Mode=OneWay}"
                                CommandParameter="{Binding SelectedReports, Mode=OneWay}"
                                Header="Выгрузить все организации в отдельные файлы" />
                            <MenuItem
                                Command="{Binding MainWindowVM.DeleteReports, Mode=OneWay}"
                                CommandParameter="{Binding SelectedReports, Mode=OneWay}"
                                Header="Удалить форму" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="*" IsReadOnly="True">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Border Classes="headerTemplate">
                                        <Grid Margin="3" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Сокращенное наименование РИАЦ" />
                                            <!--<Button Grid.Column="1"/>-->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Reports">
                                    <TextBlock Margin="5">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource IfNullShowAnotherValue}">
                                                <Binding Path="Master.Rows50[0].ShortName.Value" />
                                                <Binding Path="Master.Rows50[0].Name.Value" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Classes="pageControlContainer">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            Text="Текущая страница:" />
                        <controls:NumericLeftRight
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5"
                            Minimum="1"
                            Value="{Binding CurrentPageOrgs}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="5"
                            Text="Кол-во страниц:" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="5"
                            Text="{Binding TotalPagesOrgs}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            Text="Кол-во РИАЦ на странице:" />
                        <controls:NumericLeftRight
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Minimum="1"
                            Value="{Binding RowsCountOrgs}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="5"
                            Text="Всего РИАЦ:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="5"
                            Text="{Binding FilteredRowsOrgs}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="5"
                            Text="Всего отчетов:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="5"
                            Margin="5"
                            Text="{Binding TotalReportCount}" />
                    </Grid>
                </Border>
            </Grid>
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="5">
                <Button
                    Command="{Binding MainWindowVM.NewAddForm}"
                    CommandParameter="5.1"
                    Content="Форма 5.1" />
                <Button
                    Command="{Binding MainWindowVM.NewAddForm}"
                    CommandParameter="5.2"
                    Content="Форма 5.2" />
                <Button
                    Command="{Binding MainWindowVM.NewAddForm}"
                    CommandParameter="5.3"
                    Content="Форма 5.3" />
                <Button
                    Command="{Binding MainWindowVM.NewAddForm}"
                    CommandParameter="5.4"
                    Content="Форма 5.4" />
                <Button
                    Command="{Binding MainWindowVM.NewAddForm}"
                    CommandParameter="5.5"
                    Content="Форма 5.5" />
                <Button
                    Command="{Binding MainWindowVM.NewAddForm}"
                    CommandParameter="5.6"
                    Content="Форма 5.6" />
                <Button
                    Command="{Binding MainWindowVM.NewAddForm}"
                    CommandParameter="5.7"
                    Content="Форма 5.7" />
            </StackPanel>
            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                RowDefinitions="*,Auto">
                <DataGrid
                    Grid.Row="0"
                    Margin="5"
                    AlternatingRowBackground="White"
                    CanUserSortColumns="False"
                    GridLinesVisibility="All"
                    Items="{Binding ReportCollection}"
                    RowBackground="White"
                    RowHeight="25"
                    SelectedItem="{Binding SelectedReport}">

                    <interactivity:Interaction.Behaviors>
                        <local:DataGridDoubleClickOpenBehavior />
                    </interactivity:Interaction.Behaviors>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding MainWindowVM.NewChangeForm}"
                                CommandParameter="{Binding SelectedReport}"
                                Header="Редактировать форму" />
                            <MenuItem
                                Command="{Binding MainWindowVM.ExcelExportFormPrint}"
                                CommandParameter="{Binding SelectedReport}"
                                Header="Выгрузить форму в Excel" />
                            <MenuItem
                                Command="{Binding MainWindowVM.ExportForm}"
                                CommandParameter="{Binding SelectedReport}"
                                Header="Выгрузить" />
                            <MenuItem
                                Command="{Binding MainWindowVM.NewDeleteForm}"
                                CommandParameter="{Binding SelectedReport}"
                                Header="Удалить форму" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            x:DataType="models:Report"
                            Binding="{Binding FormNum.Value}"
                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Border Classes="headerTemplate">
                                        <Grid Margin="3" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Форма" />
                                            <!--<Button Grid.Column="1"/>-->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="*"
                            x:DataType="models:Report"
                            Binding="{Binding Year.Value}"
                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Border Classes="headerTemplate">
                                        <Grid Margin="3" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Год" />
                                            <!--<Button Grid.Column="1"/>-->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="2*"
                            x:DataType="models:Report"
                            Binding="{Binding ExportDate.Value}"
                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Border Classes="headerTemplate">
                                        <Grid Margin="3" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Дата выгрузки" />
                                            <!--<Button Grid.Column="1"/>-->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="2*"
                            x:DataType="models:Report"
                            Binding="{Binding CorrectionNumber.Value}"
                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Border Classes="headerTemplate">
                                        <Grid Margin="3" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Номер корректировки" />
                                            <!--<Button Grid.Column="1"/>-->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="4*"
                            x:DataType="models:Report"
                            Binding="{Binding Comments.Value}"
                            IsReadOnly="False">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Border Classes="headerTemplate">
                                        <Grid Margin="3" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Комментарий" />
                                            <!--<Button Grid.Column="1"/>-->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Classes="pageControlContainer">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            Text="Текущая страница:" />

                        <controls:NumericLeftRight
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5"
                            Minimum="1"
                            Value="{Binding CurrentPageForms}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="5"
                            Text="Кол-во страниц:" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="5"
                            Text="{Binding TotalPagesForms}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            Text="Отчётов на странице:" />
                        <controls:NumericLeftRight
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Minimum="1"
                            Value="{Binding RowsCountForms}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="5"
                            Text="Кол-во отчетов:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="5"
                            Text="{Binding TotalRowsForms}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="5"
                            Text="Строчек в отчёте:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="5"
                            Margin="5"
                            Text="{Binding InSelectedReportFormsCount}" />
                        <StackPanel
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="6"
                            Margin="5,0,0,0"
                            Orientation="Horizontal">
                            <Button
                                Width="35"
                                Height="40"
                                Margin="0,0,2,0"
                                Background="{Binding FormNumWhiteList, Converter={StaticResource StringEqualsToColor}, ConverterParameter=5.1}"
                                Command="{Binding MainWindowVM.GoToFormNum}"
                                CommandParameter="5.1"
                                Content="5.1" />
                            <Button
                                Width="35"
                                Height="40"
                                Margin="0,0,2,0"
                                Background="{Binding FormNumWhiteList, Converter={StaticResource StringEqualsToColor}, ConverterParameter=5.2}"
                                Command="{Binding MainWindowVM.GoToFormNum}"
                                CommandParameter="5.2"
                                Content="5.2" />
                            <Button
                                Width="35"
                                Height="40"
                                Margin="0,0,2,0"
                                Background="{Binding FormNumWhiteList, Converter={StaticResource StringEqualsToColor}, ConverterParameter=5.3}"
                                Command="{Binding MainWindowVM.GoToFormNum}"
                                CommandParameter="5.3"
                                Content="5.3" />
                            <Button
                                Width="35"
                                Height="40"
                                Margin="0,0,2,0"
                                Background="{Binding FormNumWhiteList, Converter={StaticResource StringEqualsToColor}, ConverterParameter=5.4}"
                                Command="{Binding MainWindowVM.GoToFormNum}"
                                CommandParameter="5.4"
                                Content="5.4" />
                            <Button
                                Width="35"
                                Height="40"
                                Margin="0,0,2,0"
                                Background="{Binding FormNumWhiteList, Converter={StaticResource StringEqualsToColor}, ConverterParameter=5.5}"
                                Command="{Binding MainWindowVM.GoToFormNum}"
                                CommandParameter="5.5"
                                Content="5.5" />
                            <Button
                                Width="35"
                                Height="40"
                                Margin="0,0,2,0"
                                Background="{Binding FormNumWhiteList, Converter={StaticResource StringEqualsToColor}, ConverterParameter=5.6}"
                                Command="{Binding MainWindowVM.GoToFormNum}"
                                CommandParameter="5.6"
                                Content="5.6" />
                            <Button
                                Width="35"
                                Height="40"
                                Margin="0,0,2,0"
                                Background="{Binding FormNumWhiteList, Converter={StaticResource StringEqualsToColor}, ConverterParameter=5.7}"
                                Command="{Binding MainWindowVM.GoToFormNum}"
                                CommandParameter="5.7"
                                Content="5.7" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>