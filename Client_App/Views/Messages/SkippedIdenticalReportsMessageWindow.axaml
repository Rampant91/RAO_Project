<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Messages"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.5" behaviors:WindowScreenSizeBehavior.HeightRatio="0.6"
        x:Class="Client_App.Views.Messages.SkippedIdenticalReportsMessageWindow"
        Title="Импорт из .raodb/.xlsx/.json"
        WindowStartupLocation="CenterOwner"
        MinWidth="640" MinHeight="360">

    <Design.DataContext>
        <vm:SkippedIdenticalReportsMessageWindowVM/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <TextBlock Grid.Row="0"
                   Text="Уведомление"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding SummaryMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="2"
                  Items="{Binding Reports}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  RowBackground="White"
                  AlternatingRowBackground="#DDEBF7">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Рег. №"
                                    Binding="{Binding RegNum}"
                                    Width="120"/>
                <DataGridTextColumn Header="ОКПО"
                                    Binding="{Binding Okpo}"
                                    Width="100"/>
                <DataGridTextColumn Header="Номер формы"
                                    Binding="{Binding FormNum}"
                                    Width="110"/>
                <DataGridTextColumn Header="Начало периода"
                                    Binding="{Binding StartPeriod}"
                                    Width="*"/>
                <DataGridTextColumn Header="Конец периода"
                                    Binding="{Binding EndPeriod}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Ок"
                    IsDefault="True"
                    Click="OnOkClicked"
                    Width="80"/>
        </StackPanel>
    </Grid>
</Window>
