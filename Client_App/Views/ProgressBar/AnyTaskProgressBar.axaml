<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Client_App.ViewModels.ProgressBar"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        mc:Ignorable="d"
        x:Class="Client_App.Views.ProgressBar.AnyTaskProgressBar"
        x:CompileBindings="True"
        x:DataType="vm:AnyTaskProgressBarVM"
        Title="{Binding WindowTitle, Mode=OneWay}"
        MinWidth="360" MinHeight="96"
        Width="400" Height="120"
        d:DesignWidth="400" d:DesignHeight="120"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.26" behaviors:WindowScreenSizeBehavior.HeightRatio="0.14"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        CanResize="False"
        Topmost="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Design.DataContext>
        <vm:AnyTaskProgressBarVM/>
    </Design.DataContext>

    <!--
      Как OnStartProgressBar: без рамки ОС, перетаскивание с корпуса, крестик отменяет задачу.
      Не Topmost — поверх owner (главное окно), но не поверх диалога сохранения.
    -->
    <!--#region Chrome-->
    <Border Background="#F4F6F8"
            BorderBrush="#9AA3AD"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10,12,12"
            Margin="4">
        <Grid RowDefinitions="Auto,10,Auto,8,Auto"
              ColumnDefinitions="*,Auto">
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#1F2933"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding WindowTitle, Mode=OneWay}" />

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="8,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#4B5563"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    ToolTip.Tip="Отменить операцию"
                    Content="&#x2715;"
                    IsCancel="True"
                    Command="{Binding ExcelExportCancel, Mode=OneWay}"
                    CommandParameter="{Binding CancellationTokenSource}" />

            <Panel Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Height="22">
                <ProgressBar Height="22"
                             Minimum="0"
                             Maximum="100"
                             CornerRadius="4"
                             Value="{Binding ValueBar, Mode=OneWay}" />
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#1F2933"
                           Text="{Binding ValueBarPercentText, Mode=OneWay}" />
            </Panel>

            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#1F2933"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxLines="2"
                       Text="{Binding LoadStatus, Mode=OneWay}" />
        </Grid>
    </Border>
    <!--#endregion Chrome-->
</Window>
