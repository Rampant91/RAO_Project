<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Client_App.ViewModels.ProgressBar"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        mc:Ignorable="d"
        x:Class="Client_App.Views.ProgressBar.AnyTaskProgressBar"
        x:CompileBindings="True"
        x:DataType="vm:AnyTaskProgressBarVM"
        Title="{Binding ExportType, Mode=OneWay}"
        MinWidth="340" MinHeight="140"
        MaxWidth="520" MaxHeight="240"
        d:DesignWidth="400" d:DesignHeight="160"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.26" behaviors:WindowScreenSizeBehavior.HeightRatio="0.15"
        WindowStartupLocation="Manual"
        Topmost="True"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:AnyTaskProgressBarVM/>
    </Design.DataContext>

    <!--
      Организация → статус (без %) → полоса с процентом внутри → Отмена.
    -->
    <Grid PointerMoved="InputElement_OnPointerMoved"
          PointerPressed="InputElement_OnPointerPressed"
          PointerReleased="InputElement_OnPointerReleased"
          Margin="10,6,10,6"
          RowDefinitions="Auto,4,Auto,6,Auto,8,Auto">
        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxLines="2"
                   Text="{Binding ExportName, Mode=OneWay}"/>

        <TextBlock Grid.Row="2"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   TextWrapping="Wrap"
                   MaxLines="3"
                   Text="{Binding LoadStatus, Mode=OneWay}"/>

        <Panel Grid.Row="4" Height="26">
            <ProgressBar Height="26"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ValueBar, Mode=OneWay}"/>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Text="{Binding ValueBarPercentText, Mode=OneWay}"/>
        </Panel>

        <Button Grid.Row="6"
                Height="28"
                Width="80"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,0,0,2"
                Padding="0,4"
                IsCancel="True"
                IsEnabled="True"
                Content="Отмена"
                Command="{Binding ExcelExportCancel, Mode=OneWay}"
                CommandParameter="{Binding CancellationTokenSource}"/>
    </Grid>
</Window>
