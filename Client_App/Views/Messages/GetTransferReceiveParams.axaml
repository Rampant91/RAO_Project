<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Messages"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        mc:Ignorable="d"
        x:Class="Client_App.Views.Messages.GetTransferReceiveParams"
        x:CompileBindings="True"
        x:DataType="vm:GetTransferReceiveParamsVM"
        Title="Параметры сопоставления приёма-передачи"
        MinWidth="520" MinHeight="720"
        d:DesignWidth="560" d:DesignHeight="780"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.30" behaviors:WindowScreenSizeBehavior.HeightRatio="0.72"
        WindowStartupLocation="Manual"
        CanResize="True">
    <Window.Styles>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.selectAllCaption">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:GetTransferReceiveParamsVM/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="Выберите поля для сопоставления операций приёма/передачи по формам 1.1 и 1.3. По умолчанию все включены. Формы сверяются только сами с собой. Для суммарной активности — допуск ±10%. Дата операции должна совпадать точно (отличие на 1 день — уже ошибка); окно ±15 дней только сужает поиск кандидатов. На форме 1.3 вместо количества сравнивается агрегатное состояние; количество всегда считается равным 1. Рег.№, ОКПО организации, наименование, период и № п/п в сравнении не участвуют."/>

        <Border Grid.Row="1"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="sectionHeader" Text="Форма 1.1"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <CheckBox Grid.Row="0" Grid.Column="0" IsThreeState="True" IsChecked="{Binding CheckAll, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <TextBlock Classes="selectAllCaption" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text="Выбрать все параметры"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding CheckOperationCode, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="Код операции (парность 21↔31 и т.д.)"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding CheckOperationDate, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="Дата операции (точное совпадение; поиск ±15 дн.)"/>
                                <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding CheckPassportNumber, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="Номер паспорта"/>
                                <CheckBox Grid.Row="4" Grid.Column="0" IsChecked="{Binding CheckType, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="Тип"/>
                                <CheckBox Grid.Row="5" Grid.Column="0" IsChecked="{Binding CheckRadionuclids, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Text="Радионуклиды"/>
                                <CheckBox Grid.Row="6" Grid.Column="0" IsChecked="{Binding CheckFactoryNumber, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Text="Заводской номер"/>
                                <CheckBox Grid.Row="7" Grid.Column="0" IsChecked="{Binding CheckQuantity, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Text="Количество"/>
                                <CheckBox Grid.Row="8" Grid.Column="0" IsChecked="{Binding CheckActivity, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Text="Суммарная активность (±10%)"/>
                                <CheckBox Grid.Row="9" Grid.Column="0" IsChecked="{Binding CheckCreatorOkpo, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" VerticalAlignment="Center" Text="Код ОКПО изготовителя"/>
                                <CheckBox Grid.Row="10" Grid.Column="0" IsChecked="{Binding CheckCreationDate, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" VerticalAlignment="Center" Text="Дата выпуска"/>
                                <CheckBox Grid.Row="11" Grid.Column="0" IsChecked="{Binding CheckProviderOrRecieverOkpo, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" VerticalAlignment="Center" Text="ОКПО поставщика/получателя (обратная ссылка)"/>
                                <CheckBox Grid.Row="12" Grid.Column="0" IsChecked="{Binding CheckPackNumber, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" VerticalAlignment="Center" Text="Номер УКТ"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="sectionHeader" Text="Форма 1.3"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <CheckBox Grid.Row="0" Grid.Column="0" IsThreeState="True" IsChecked="{Binding CheckAll13, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <TextBlock Classes="selectAllCaption" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text="Выбрать все параметры"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding CheckOperationCode13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="Код операции (парность 21↔31 и т.д.)"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding CheckOperationDate13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="Дата операции (точное совпадение; поиск ±15 дн.)"/>
                                <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding CheckPassportNumber13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="Номер паспорта"/>
                                <CheckBox Grid.Row="4" Grid.Column="0" IsChecked="{Binding CheckType13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="Тип"/>
                                <CheckBox Grid.Row="5" Grid.Column="0" IsChecked="{Binding CheckRadionuclids13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Text="Радионуклиды"/>
                                <CheckBox Grid.Row="6" Grid.Column="0" IsChecked="{Binding CheckFactoryNumber13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Text="Заводской номер"/>
                                <CheckBox Grid.Row="7" Grid.Column="0" IsChecked="{Binding CheckAggregateState13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Text="Агрегатное состояние"/>
                                <CheckBox Grid.Row="8" Grid.Column="0" IsChecked="{Binding CheckActivity13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Text="Суммарная активность (±10%)"/>
                                <CheckBox Grid.Row="9" Grid.Column="0" IsChecked="{Binding CheckCreatorOkpo13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" VerticalAlignment="Center" Text="Код ОКПО изготовителя"/>
                                <CheckBox Grid.Row="10" Grid.Column="0" IsChecked="{Binding CheckCreationDate13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" VerticalAlignment="Center" Text="Дата выпуска"/>
                                <CheckBox Grid.Row="11" Grid.Column="0" IsChecked="{Binding CheckProviderOrRecieverOkpo13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" VerticalAlignment="Center" Text="ОКПО поставщика/получателя (обратная ссылка)"/>
                                <CheckBox Grid.Row="12" Grid.Column="0" IsChecked="{Binding CheckPackNumber13, Mode=TwoWay}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" VerticalAlignment="Center" Text="Номер УКТ"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Margin="0,12,0,0">
            <Button Content="Ок" Width="100" IsDefault="True" Click="OnOkButtonClicked"/>
            <Button Content="Отмена" Width="100" IsCancel="True" Click="OnCancelButtonClicked"/>
        </StackPanel>
    </Grid>
</Window>
