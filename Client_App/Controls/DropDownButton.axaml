<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Client_App.Behaviors"
             xmlns:controlBehaviors="using:Client_App.Behaviors.Controls"
             x:Class="Client_App.Controls.DropDownButton">

    <Button Width="16"
            Height="16"
            Background="LightGray"
            BorderThickness="1"
            BorderBrush="Gray"
            Padding="0"
            Margin="2,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ToolTip.Tip="Открыть список">

        <Interaction.Behaviors>
            <controlBehaviors:DropDownButtonBehavior />
        </Interaction.Behaviors>

        <Path Data="M 0 0 L 4 4 L 8 0"
              Stroke="Black"
              StrokeThickness="1"
              Fill="Black"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
    </Button>
</UserControl>