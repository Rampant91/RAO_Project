<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	         xmlns:interactivity="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
			 xmlns:behaviors="using:Client_App.Behaviors"
			 xmlns:inputBehaviors="using:Client_App.Behaviors.Input"
			 xmlns:controlBehaviors="using:Client_App.Behaviors.Controls"
             xmlns:local="using:Client_App"
             xmlns:resources="clr-namespace:Client_App.Resources"
             xmlns:converters="clr-namespace:Client_App.Converters"
             xmlns:visualConverters="clr-namespace:Client_App.VisualRealization.Converters"
			 xmlns:appControls="using:Client_App.Controls"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             x:Class="Client_App.App">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <resources:RatioConverter x:Key="RatioConverter"/>
        <converters:StringToDateTimeConverter x:Key="StringToDateTimeConverter"/>
        <visualConverters:ShortNullableToStringConverter x:Key="ShortNullableToStringConverter"/>
        <visualConverters:ByteNullableToStringConverter x:Key="ByteNullableToStringConverter"/>
        <visualConverters:ByteNullableOrDashToStringConverter x:Key="ByteNullableOrDashToStringConverter"/>
        <visualConverters:FrozenOperationHeaderColSpanConverter x:Key="FrozenOperationHeaderColSpanConverter"/>
        <!--
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type vm:CheckFormVM}">
                <v:CheckForm/>
            </DataTemplate>
        </ResourceDictionary>
        -->
        <!--Палитра-->
        <SolidColorBrush x:Key="PrimaryColor" Color="#99d3f0"/>
        <!-- Avalonia 11 Fluent: шаблон DataGridColumnHeader резервирует ~32px под SortIcon
             даже при CanUserSortColumns=False — из-за этого справа «пустое» место перекрывает
             хвост заголовка. См. Avalonia#9791 / Discussion#15442. -->
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>

    </Application.Resources>


    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!--
          Scrollbars stay expanded (not thin overlay). Compact/auto-hide can be a settings option later.
        -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="18"/>
            <Setter Property="MinWidth" Value="18"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinHeight" Value="18"/>
        </Style>

        <Style Selector="DataGridCell.cell_tooltip">
            <Setter Property="ToolTip.Tip" Value="{Binding Content.Text, Mode=OneWay, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style Selector="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid
                        RowDefinitions="Auto,*"
                        ColumnDefinitions="Auto,*">

                        <!-- Header -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            ZIndex="1"
                            Background="White"
                            Padding="5,0,5,0"
                            Margin="5,0,0,0">
                            <TextBlock
                                Text="{TemplateBinding Header}"
                                FontWeight="Bold"/>
                        </Border>

                        <!-- Content Area -->
                        <Border
                            Grid.Row="0" Grid.RowSpan="2"
                            Padding="0,5,0,0"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            CornerRadius="4"
                            Margin="0,10,0,0"
                            BorderBrush="Black"
                            
                            BorderThickness="1">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Padding="8"
                                Content="{TemplateBinding Content}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
		
	    <!--Общие стили-->
		
			<!--Из-за особенностей предметной области допускается, что пользователи могут ввести вместо даты строку
			    Поэтому buttonOnly предназначен для использвания в связки с другим текстбоксом -->
        <Style Selector="CalendarDatePicker.buttonOnly TextBox">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
		<Style Selector="CalendarDatePicker.buttonOnly">
			<Setter Property="controlBehaviors:ScrollBlock.BlockPointerWheel" Value="True"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="MinWidth" Value="28"/>
			<Setter Property="MaxWidth" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
		</Style>
		<Style Selector="Border#Background">
			<Setter Property="Background" Value="#f0f8ff"/>
        </Style>
		<Style Selector="TextBox">
			<Setter Property="inputBehaviors:TextBoxAutoTrim.IsEnabled" Value="True"/>
		</Style>
		<Style Selector="Button">
			<Setter Property="IsTabStop" Value="False"/>
		</Style>

		<Style Selector="Expander">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="Expander > ToggleButton">
			<Setter Property="IsTabStop" Value="False"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="MinHeight" Value="18"/>
			<Setter Property="Padding" Value="6,1"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
		
		<Style Selector="TextBox">
			<Setter Property="behaviors:TextBoxAutoTrim.IsEnabled" Value="True"/>
		</Style>
        <!--Стили для окон редактирования форм-->
        <!--Header-->
        <Style Selector="CheckBox.hideButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="WrapPanel.header">
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>
        <Style Selector="WrapPanel.header Border.borderContainer">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Border.borderContainer TextBox">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="WrapPanel.header Button">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style Selector="WrapPanel.header StackPanel">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="WrapPanel.header StackPanel > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="WrapPanel.header StackPanel > TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="WrapPanel.header StackPanel > CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.report-period-date">
            <Setter Property="Width" Value="100"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="MaxWidth" Value="100"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="inputBehaviors:ReportPeriodDateInput.IsEnabled" Value="True"/>
            <Setter Property="inputBehaviors:OrgFormValidationPresentation.IsEnabled" Value="True"/>
        </Style>
        <Style Selector="MaskedTextBox.report-period-date">
            <Setter Property="Width" Value="100"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="MaxWidth" Value="100"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="inputBehaviors:ReportPeriodDateInput.IsEnabled" Value="True"/>
            <Setter Property="inputBehaviors:OrgFormValidationPresentation.IsEnabled" Value="True"/>
        </Style>
        <Style Selector="TextBox.report-period-date /template/ DataValidationErrors">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="MaskedTextBox.report-period-date /template/ DataValidationErrors">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!--Org form windows 1.0, 2.0, 4.0, 5.0-->
        <Style Selector="Window.orgForm TextBlock.org-label">
            <Setter Property="Margin" Value="5,6,12,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style Selector="Window.orgForm TextBlock.org-top-label">
            <Setter Property="Margin" Value="5,8,12,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style Selector="Window.orgForm TextBlock.org-section-title">
            <Setter Property="Margin" Value="5,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Window.orgForm TextBox.org-field">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,5,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,2,4,2"/>
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="inputBehaviors:OrgFormValidationPresentation.IsEnabled" Value="True"/>
        </Style>
        <Style Selector="Window.orgForm TextBox.org-field /template/ DataValidationErrors">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm TextBox.org-field /template/ DataValidationErrors /template/ ContentControl">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm TextBox.org-multiline">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxHeight" Value="72"/>
            <Setter Property="Margin" Value="0,3,5,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="4,2,4,2"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="inputBehaviors:OrgFormValidationPresentation.IsEnabled" Value="True"/>
        </Style>
        <Style Selector="Window.orgForm TextBox.org-multiline /template/ DataValidationErrors">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm TextBox.org-multiline /template/ DataValidationErrors /template/ ContentControl">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-field">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,5,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="inputBehaviors:OrgFormValidationPresentation.IsEnabled" Value="True"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-field /template/ DataValidationErrors">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-field /template/ DataValidationErrors /template/ ContentControl">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-field /template/ TextBox#PART_TextBox">
            <Setter Property="Padding" Value="4,2,4,2"/>
        </Style>
        <Style Selector="Window.orgForm Border.org-subject-rf-frame">
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="Window.orgForm ComboBox.org-subject-rf-code">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="inputBehaviors:OrgFormValidationPresentation.IsEnabled" Value="True"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code /template/ TextBox#PART_TextBox">
            <Setter Property="Padding" Value="0,2,2,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code /template/ DataValidationErrors">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code /template/ DataValidationErrors /template/ ContentControl">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code /template/ ContentControl#PART_Watermark">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code Popup">
            <Setter Property="MinWidth" Value="480"/>
            <Setter Property="MaxWidth" Value="480"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code Popup ListBox">
            <Setter Property="MinWidth" Value="480"/>
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code Popup ListBoxItem">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code /template/ ListBox">
            <Setter Property="MinWidth" Value="480"/>
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Window.orgForm AutoCompleteBox.org-subject-rf-code /template/ ListBoxItem">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Window.orgForm TextBlock.org-subject-rf-placeholder">
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Window.orgForm TextBox.org-subject-rf-readonly">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!--TableHeader-->
        <Style Selector="ScrollViewer.tableScrollViewer">
            <!-- Disabled: Avalonia DataGrid must measure with a finite width. Auto/Visible
                 pass Infinity to the child; DataGrid then writes Infinity into the last column
                 (DataGridLength ctor: value cannot be set to infinity). Horizontal scroll is
                 DataGrid's own scrollbar; the custom header follows via FrozenHeaderScrollSyncBehavior. -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="Grid.tableHeader">
            <Setter Property="Margin" Value="6,5,-5,5"/>
            <Setter Property="Background" Value="#f5f5f5"/>
        </Style>
        <Style Selector="Grid.tableHeader Border">
            <Setter Property="Margin" Value="-1,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#aaaaaa"/>
        </Style>
        <Style Selector="Grid.tableHeader TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
        </Style>
        <Style Selector="Grid.tableHeader Border.frozenOperationHeader TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style Selector="Grid.tableHeader Border.header-rowspan-bottom">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!--Table-->
        <Style Selector="DataGrid.table">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="6,-5,5,5"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="ColumnWidth" Value="125" />
            <Setter Property="MinColumnWidth" Value="30" />
            <!-- REPORT TABLE WIDTH (do not remove this comment):
                 MaxColumnWidth must NOT be set in this style. Avalonia 11.2.6 applies styles after
                 DataGrid.Columns are loaded; changing default Infinity -> 500 then crashes with
                 ArgumentException "value cannot be set to infinity" (debugger often stops on the
                 last column in XAML — that is a red herring). Set MaxColumnWidth="500" on each
                 report DataGrid element instead. Details: datagrid-report-table-width.mdc -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
		
		<Style Selector="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,1,1,1"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="DataGrid.table DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="DataGrid.table DataGridColumnHeader Border.headerTemplate TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid">
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <!-- Floor so a column cannot be dragged to zero / fully hidden. -->
            <Setter Property="MinColumnWidth" Value="60"/>
            <!--
              Star-колонки + UseLayoutRounding: вертикальные линии (ячейки/заголовки) пропадают
              при ресайзе/пересчёте (Avalonia.Controls.DataGrid#71, #160).
            -->
            <Setter Property="UseLayoutRounding" Value="False"/>
            <!-- Lines via GridLines only: cell BorderThickness + PART_RightGridLine otherwise double. -->
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFB0B0B0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFB0B0B0"/>
            <Setter Property="BorderBrush" Value="#FFB0B0B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Visible reserves scrollbar gutter; AllowAutoHide=False keeps it always shown. -->
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid DataGridColumnHeader">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <!-- Right edge: header separators without relying only on rounded gridlines. -->
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#FFB0B0B0"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
        </Style>
        <!-- Report grids: two-line headers; keep compact so default 10 rows still fit. -->
        <Style Selector="DataGrid.report-list-grid">
            <Setter Property="ColumnHeaderHeight" Value="34"/>
        </Style>
        <Style Selector="DataGrid.report-list-grid DataGridColumnHeader">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MaxHeight" Value="34"/>
            <Setter Property="Padding" Value="2,0,2,0"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid DataGridColumnHeader /template/ ContentPresenter">
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid DataGridColumnHeader /template/ Thumb">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="MaxWidth" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid DataGridColumnHeader:pointerover /template/ Thumb">
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Background" Value="#40000000"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid Border.headerTemplate TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="2,2,8,2"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid DataGridCell TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Tabular figures: same digit count => same width, without monospace body text. -->
            <Setter Property="FontFeatures" Value="+tnum"/>
        </Style>
        <!-- Radionuclide abbreviations: fixed pitch so same length lines up (tnum alone is digits-only). -->
        <Style Selector="DataGrid.main-list-grid DataGridCell.calc-abbrev TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        </Style>
        <Style Selector="TextBlock.calc-abbrev">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        </Style>
        <Style Selector="TextBox.calc-abbrev">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        </Style>
        <!-- Report rows: center all cells; comments stay left (CellStyleClasses=comments-column). -->
        <Style Selector="DataGrid.report-list-grid DataGridCell TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="DataGrid.report-list-grid DataGridCell.comments-column TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <Style Selector="DataGrid.report-list-grid DataGridCell.comments-column TextBox">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="DataGrid.main-list-grid DataGridCell TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="InnerRightContent" Value="{x:Null}"/>
            <Setter Property="FontFeatures" Value="+tnum"/>
        </Style>
        <!-- Default Fluent docks a validation icon on the right (looks like a button under the scrollbar). -->
        <Style Selector="DataGrid.main-list-grid DataGridCell TextBox /template/ DataValidationErrors">
            <Setter Property="Theme" Value="{StaticResource TooltipDataValidationErrors}"/>
        </Style>
		
		<Style Selector="Border.headerTemplate">
			<Setter Property="BorderThickness" Value="0"/>
		    <Setter Property="BorderBrush" Value="Transparent"/>
		    <Setter Property="Margin" Value="0"/>
		    <Setter Property="HorizontalAlignment" Value="Stretch"/>
		    <Setter Property="VerticalAlignment" Value="Stretch"/>
		</Style>
		
		<Style Selector="Border.headerTemplate TextBlock">
			<Setter Property="TextAlignment" Value="Center"/>
		    <Setter Property="VerticalAlignment" Value="Center"/>
		    <Setter Property="HorizontalAlignment" Value="Stretch"/>
		    <Setter Property="Margin" Value="2,2"/>
			<Setter Property="TextWrapping" Value="NoWrap"/>
		</Style>
        <!-- Must be AFTER Border.headerTemplate TextBlock (NoWrap), otherwise wrap never wins. -->
        <Style Selector="DataGrid.report-list-grid Border.headerTemplate TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="14"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>
		<Style Selector="Border.headerTemplate-compact">
			<Setter Property="Padding" Value="2,1"/>
		</Style>
		<Style Selector="Border.headerTemplate-compact TextBlock">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		
		<Style Selector="Border.headerTemplate Button">
            <Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Content" Value="˅"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,2,5,2"/>
			<Setter Property="Background" Value="#f0f8ff"/>
		</Style>
		<Style Selector="DataGrid DataGridRow:selected DataGridCell">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Foreground" Value="Black"/>
		    <Setter Property="Background" Value="LightBlue"/>
        </Style>
        <Style Selector="DataGrid DataGridRow:pointerover:not(:selected) DataGridCell">
            <Setter Property="Foreground" Value="Black"/>
		    <Setter Property="Background" Value="LightGray"/>
        </Style>
		<Style Selector="DataGrid TextBox">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="DataGrid AutoCompleteBox">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		
        <Style Selector="DataGrid.table TextBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
        <Style Selector="DataGrid.table TextBox /template/ DataValidationErrors">
            <Setter Property="Theme" Value="{StaticResource TooltipDataValidationErrors}"/>
        </Style>
        <Style Selector="DataGrid.table TextBox /template/ DataValidationErrors /template/ ContentControl">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="ZIndex" Value="2"/>
        </Style>
        <Style Selector="DataGrid.table AutoCompleteBox">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="DataGrid.table Button">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="DataGrid.table CalendarDatePicker">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="DataGrid.table appControls|RadionuclidsSelector">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="DataGrid.table appControls|DropDownButton">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="DataGrid.table ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="DataGrid.table CalendarDatePicker">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Watermark" Value="&lt;дд.мм.гггг&gt;"/>
        </Style>
		
        <!--PageControl-->
        <Style Selector="Border.pageControlContainer">
			<Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>
		<Style Selector="Border.pageControlContainer TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.pageControlContainer NumericUpDown">
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
		<Style Selector="Border.pageControlContainer StackPanel.form-filter-panel">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.pageControlContainer StackPanel.form-filter-panel > TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.pageControlContainer StackPanel.form-filter-panel > StackPanel">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Panel#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
		
        <!--Notes-->
		<Style Selector="Border.notesContainer">
			<Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Margin" Value="3,2,3,2"/>
		</Style>
        <Style Selector="Border.notesContainer StackPanel">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="DataGrid.notesTable">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="MaxHeight" Value="170"/>
			<Setter Property="ColumnHeaderHeight" Value="24"/>
            <Setter Property="RowBackground" Value="White"/>
			<Setter Property="Background" Value="LightGray"/>
			<Setter Property="SelectionMode" Value="Extended"/>
			<Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="Margin" Value="3,2,3,2"/>
			<Setter Property="GridLinesVisibility" Value="All"/>
        </Style>

		<Style Selector="DataGrid.notesTable DataGridColumnHeader">
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
	    </Style>
		<Style Selector="DataGrid.notesTable TextBox">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="MinHeight" Value="24"/>
			<Setter Property="MaxHeight" Value="100"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
        <!--Конец стилей для окон редактирования форм-->
		<!--Другие стили-->
		<Style Selector="DataGrid DataGridRow DataGridCell TextBlock.readOnly">
			<Setter Property="Background" Value="#ededed"/>
			<Setter Property="Foreground" Value="#93140e"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0,5,0,0"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>
		<Style Selector="DataGrid DataGridRow:pointerover:not(:selected) DataGridCell TextBlock.readOnly">
			<Setter Property="Background" Value="#b5b5b5"/>
			<Setter Property="Foreground" Value="#93140e"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0,5,0,0"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>
		<Style Selector="DataGrid DataGridRow:selected DataGridCell TextBlock.readOnly">
			<Setter Property="Background" Value="#86c4d9"/>
			<Setter Property="Foreground" Value="#93140e"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0,5,0,0"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>

		<Style Selector="AutoCompleteBox.hitable">
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>
		<Style Selector="AutoCompleteBox.hitable TextBox">
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>

		<!-- Legacy DataGrid: плоские ячейки как Excel, ошибка — иконка внутри -->
		<Style Selector="TextBox.legacy-dg-cell">
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="2,0,14,0"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="inputBehaviors:LegacyCellValidationPresentation.IsEnabled" Value="True"/>
		</Style>
		<Style Selector="TextBox.legacy-dg-cell /template/ DataValidationErrors">
			<Setter Property="Theme" Value="{StaticResource TooltipDataValidationErrors}"/>
		</Style>
		<Style Selector="TextBox.legacy-dg-cell /template/ DataValidationErrors /template/ ContentControl">
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,1,0"/>
			<Setter Property="ZIndex" Value="2"/>
		</Style>

		<Style Selector="ScrollViewer.legacy-dg-scroll">
			<Setter Property="AllowAutoHide" Value="False"/>
		</Style>

        <Style Selector="DataGrid.dbPicker">
            <Setter Property="FontSize" Value="12"/>
            <!-- Outer frame supplies top/left edges; cells/headers draw right/bottom. -->
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
        </Style>
    </Application.Styles>
</Application>