<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Messages"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        mc:Ignorable="d"
        x:Class="Client_App.Views.Messages.GetTransferReceiveParams"
        x:CompileBindings="True"
        x:DataType="vm:GetTransferReceiveParamsVM"
        Title="Параметры сопоставления приёма-передачи"
        MinWidth="1280" MinHeight="780"
        d:DesignWidth="1440" d:DesignHeight="900"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.92" behaviors:WindowScreenSizeBehavior.HeightRatio="0.90"
        WindowStartupLocation="Manual"
        CanResize="True">
    <Window.Styles>
        <Style Selector="TextBlock.introText">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.selectAllCaption">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.fieldCaption">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.placeholderNote">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#707070"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style Selector="Border.formCard">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.formCardPlaceholder">
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:GetTransferReceiveParamsVM/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <TextBlock Grid.Row="0"
                   Classes="introText"
                   Margin="0,0,0,10"
                   Text="Выберите поля для сопоставления по формам 1.1–1.8. Если снять «Выбрать все» у формы — она не загружается и не попадает в отчёт. Активность и масса: допуск ±10%. Дата операции — точное совпадение (поиск похожих ±15 дн.)."/>

        <Border Grid.Row="1"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="5"
                Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- 1.1–1.4 | 1.5–1.8 -->
                <Grid ColumnDefinitions="*,*,*,*"
                      RowDefinitions="Auto,Auto"
                      Margin="4">

                    <!-- ========== Ряд 1: 1.1–1.4 ========== -->

                    <Border Grid.Row="0" Grid.Column="0" Classes="formCard">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionHeader" Text="Форма 1.1"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <CheckBox Grid.Row="0" Grid.Column="0" IsThreeState="True" IsChecked="{Binding CheckAll, Mode=TwoWay}" Margin="0,0,6,0"/>
                                <TextBlock Classes="selectAllCaption" Grid.Row="0" Grid.Column="1" Text="Выбрать все"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding CheckOperationCode, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="1" Grid.Column="1" Text="Код операции (парность 21↔31 и т.д.)"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding CheckOperationDate, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="2" Grid.Column="1" Text="Дата операции"/>
                                <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding CheckPassportNumber, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="3" Grid.Column="1" Text="Номер паспорта"/>
                                <CheckBox Grid.Row="4" Grid.Column="0" IsChecked="{Binding CheckType, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="4" Grid.Column="1" Text="Тип"/>
                                <CheckBox Grid.Row="5" Grid.Column="0" IsChecked="{Binding CheckRadionuclids, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="5" Grid.Column="1" Text="Радионуклиды"/>
                                <CheckBox Grid.Row="6" Grid.Column="0" IsChecked="{Binding CheckFactoryNumber, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="6" Grid.Column="1" Text="Заводской номер"/>
                                <CheckBox Grid.Row="7" Grid.Column="0" IsChecked="{Binding CheckQuantity, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="7" Grid.Column="1" Text="Количество"/>
                                <CheckBox Grid.Row="8" Grid.Column="0" IsChecked="{Binding CheckActivity, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="8" Grid.Column="1" Text="Суммарная активность"/>
                                <CheckBox Grid.Row="9" Grid.Column="0" IsChecked="{Binding CheckCreatorOkpo, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="9" Grid.Column="1" Text="Код ОКПО изготовителя"/>
                                <CheckBox Grid.Row="10" Grid.Column="0" IsChecked="{Binding CheckCreationDate, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="10" Grid.Column="1" Text="Дата выпуска"/>
                                <CheckBox Grid.Row="11" Grid.Column="0" IsChecked="{Binding CheckProviderOrRecieverOkpo, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="11" Grid.Column="1" Text="ОКПО поставщика/получателя"/>
                                <CheckBox Grid.Row="12" Grid.Column="0" IsChecked="{Binding CheckPackNumber, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="12" Grid.Column="1" Text="Номер УКТ"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Classes="formCard">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionHeader" Text="Форма 1.2"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <CheckBox Grid.Row="0" Grid.Column="0" IsThreeState="True" IsChecked="{Binding CheckAll12, Mode=TwoWay}" Margin="0,0,6,0"/>
                                <TextBlock Classes="selectAllCaption" Grid.Row="0" Grid.Column="1" Text="Выбрать все"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding CheckOperationCode12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="1" Grid.Column="1" Text="Код операции (парность 21↔31 и т.д.)"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding CheckOperationDate12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="2" Grid.Column="1" Text="Дата операции"/>
                                <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding CheckPassportNumber12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="3" Grid.Column="1" Text="Номер паспорта"/>
                                <CheckBox Grid.Row="4" Grid.Column="0" IsChecked="{Binding CheckName12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="4" Grid.Column="1" Text="Наименование"/>
                                <CheckBox Grid.Row="5" Grid.Column="0" IsChecked="{Binding CheckFactoryNumber12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="5" Grid.Column="1" Text="Заводской номер"/>
                                <CheckBox Grid.Row="6" Grid.Column="0" IsChecked="{Binding CheckMass12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="6" Grid.Column="1" Text="Масса обеднённого урана, кг"/>
                                <CheckBox Grid.Row="7" Grid.Column="0" IsChecked="{Binding CheckCreatorOkpo12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="7" Grid.Column="1" Text="Код ОКПО изготовителя"/>
                                <CheckBox Grid.Row="8" Grid.Column="0" IsChecked="{Binding CheckCreationDate12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="8" Grid.Column="1" Text="Дата выпуска"/>
                                <CheckBox Grid.Row="9" Grid.Column="0" IsChecked="{Binding CheckProviderOrRecieverOkpo12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="9" Grid.Column="1" Text="ОКПО поставщика/получателя"/>
                                <CheckBox Grid.Row="10" Grid.Column="0" IsChecked="{Binding CheckPackType12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="10" Grid.Column="1" Text="Тип УКТ"/>
                                <CheckBox Grid.Row="11" Grid.Column="0" IsChecked="{Binding CheckPackNumber12, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="11" Grid.Column="1" Text="Номер УКТ"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Classes="formCard">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionHeader" Text="Форма 1.3"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <CheckBox Grid.Row="0" Grid.Column="0" IsThreeState="True" IsChecked="{Binding CheckAll13, Mode=TwoWay}" Margin="0,0,6,0"/>
                                <TextBlock Classes="selectAllCaption" Grid.Row="0" Grid.Column="1" Text="Выбрать все"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding CheckOperationCode13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="1" Grid.Column="1" Text="Код операции (парность 21↔31 и т.д.)"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding CheckOperationDate13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="2" Grid.Column="1" Text="Дата операции"/>
                                <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding CheckPassportNumber13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="3" Grid.Column="1" Text="Номер паспорта"/>
                                <CheckBox Grid.Row="4" Grid.Column="0" IsChecked="{Binding CheckType13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="4" Grid.Column="1" Text="Тип"/>
                                <CheckBox Grid.Row="5" Grid.Column="0" IsChecked="{Binding CheckRadionuclids13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="5" Grid.Column="1" Text="Радионуклиды"/>
                                <CheckBox Grid.Row="6" Grid.Column="0" IsChecked="{Binding CheckFactoryNumber13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="6" Grid.Column="1" Text="Заводской номер"/>
                                <CheckBox Grid.Row="7" Grid.Column="0" IsChecked="{Binding CheckActivity13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="7" Grid.Column="1" Text="Суммарная активность"/>
                                <CheckBox Grid.Row="8" Grid.Column="0" IsChecked="{Binding CheckCreatorOkpo13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="8" Grid.Column="1" Text="Код ОКПО изготовителя"/>
                                <CheckBox Grid.Row="9" Grid.Column="0" IsChecked="{Binding CheckCreationDate13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="9" Grid.Column="1" Text="Дата выпуска"/>
                                <CheckBox Grid.Row="10" Grid.Column="0" IsChecked="{Binding CheckAggregateState13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="10" Grid.Column="1" Text="Агрегатное состояние"/>
                                <CheckBox Grid.Row="11" Grid.Column="0" IsChecked="{Binding CheckProviderOrRecieverOkpo13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="11" Grid.Column="1" Text="ОКПО поставщика/получателя"/>
                                <CheckBox Grid.Row="12" Grid.Column="0" IsChecked="{Binding CheckPackNumber13, Mode=TwoWay}" Margin="0,1,6,1"/>
                                <TextBlock Classes="fieldCaption" Grid.Row="12" Grid.Column="1" Text="Номер УКТ"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="3" Classes="formCardPlaceholder">
                        <StackPanel>
                            <TextBlock Classes="sectionHeader" Text="Форма 1.4"/>
                            <TextBlock Classes="placeholderNote" Text="Сверка для этой формы будет добавлена позже."/>
                        </StackPanel>
                    </Border>

                    <!-- ========== Ряд 2: 1.5–1.8 ========== -->

                    <Border Grid.Row="1" Grid.Column="0" Classes="formCardPlaceholder">
                        <StackPanel>
                            <TextBlock Classes="sectionHeader" Text="Форма 1.5"/>
                            <TextBlock Classes="placeholderNote" Text="Сверка для этой формы будет добавлена позже."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Classes="formCardPlaceholder">
                        <StackPanel>
                            <TextBlock Classes="sectionHeader" Text="Форма 1.6"/>
                            <TextBlock Classes="placeholderNote" Text="Сверка для этой формы будет добавлена позже."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Classes="formCardPlaceholder">
                        <StackPanel>
                            <TextBlock Classes="sectionHeader" Text="Форма 1.7"/>
                            <TextBlock Classes="placeholderNote" Text="Сверка для этой формы будет добавлена позже."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="3" Classes="formCardPlaceholder">
                        <StackPanel>
                            <TextBlock Classes="sectionHeader" Text="Форма 1.8"/>
                            <TextBlock Classes="placeholderNote" Text="Сверка для этой формы будет добавлена позже."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Margin="0,12,0,0">
            <Button Content="Ок" Width="100" IsDefault="True" Click="OnOkButtonClicked"/>
            <Button Content="Отмена" Width="100" IsCancel="True" Click="OnCancelButtonClicked"/>
        </StackPanel>
    </Grid>
</Window>
