<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Messages"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        mc:Ignorable="d"
        x:Class="Client_App.Views.Messages.GroupBulkExportReportsMessageWindow"
        x:CompileBindings="True"
        x:DataType="vm:GroupBulkExportReportsMessageVM"
        Title="Групповая выгрузка отчётов"
        MinWidth="520" MinHeight="720"
        d:DesignWidth="520" d:DesignHeight="720"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.35" behaviors:WindowScreenSizeBehavior.HeightRatio="0.65"
        WindowStartupLocation="Manual"
        CanResize="True">

    <Design.DataContext>
        <vm:GroupBulkExportReportsMessageVM/>
    </Design.DataContext>

    <ScrollViewer>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              Margin="10">

            <TextBlock Grid.Row="0"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Text="Укажите файл .xlsx со списком организаций: в 1-й колонке — рег. №, во 2-й — ОКПО. Выберите формы 1.1–1.9 и 2.1–2.12, период выгрузки и папку для сохранения файлов .RAODB."/>

            <Border Grid.Row="1"
                    Margin="0,0,0,8"
                    Padding="8"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Spacing="6">
                    <TextBlock Text="Файл .xlsx со списком организаций:" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 IsReadOnly="True"
                                 Text="{Binding ExcelFilePath, Mode=TwoWay}"
                                 Watermark="Не выбран"/>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="Обзор..."
                                Click="OnBrowseExcelClicked"
                                MinWidth="90"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,0,0,8"
                    Padding="8"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Spacing="8">
                    <TextBlock Text="Формы для выгрузки:" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,8,4" Text="Выбрать все:"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Name="AllForms"
                                  IsThreeState="True"
                                  IsChecked="{Binding CheckAllForms, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontWeight="SemiBold" Margin="0,4,0,2" Text="Формы 1.x"/>
                        <CheckBox Grid.Row="2" Grid.Column="0" Content="1.1" IsChecked="{Binding CheckForm11, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="1.2" IsChecked="{Binding CheckForm12, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="3" Grid.Column="0" Content="1.3" IsChecked="{Binding CheckForm13, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" Content="1.4" IsChecked="{Binding CheckForm14, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="4" Grid.Column="0" Content="1.5" IsChecked="{Binding CheckForm15, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="1.6" IsChecked="{Binding CheckForm16, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="5" Grid.Column="0" Content="1.7" IsChecked="{Binding CheckForm17, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" Content="1.8" IsChecked="{Binding CheckForm18, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="6" Grid.Column="0" Content="1.9" IsChecked="{Binding CheckForm19, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" FontWeight="SemiBold" Margin="0,8,0,2" Text="Формы 2.x"/>
                        <CheckBox Grid.Row="8" Grid.Column="0" Content="2.1" IsChecked="{Binding CheckForm21, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="8" Grid.Column="1" Content="2.2" IsChecked="{Binding CheckForm22, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="9" Grid.Column="0" Content="2.3" IsChecked="{Binding CheckForm23, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="9" Grid.Column="1" Content="2.4" IsChecked="{Binding CheckForm24, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="10" Grid.Column="0" Content="2.5" IsChecked="{Binding CheckForm25, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="10" Grid.Column="1" Content="2.6" IsChecked="{Binding CheckForm26, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="11" Grid.Column="0" Content="2.7" IsChecked="{Binding CheckForm27, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="11" Grid.Column="1" Content="2.8" IsChecked="{Binding CheckForm28, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="12" Grid.Column="0" Content="2.9" IsChecked="{Binding CheckForm29, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="12" Grid.Column="1" Content="2.10" IsChecked="{Binding CheckForm210, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="13" Grid.Column="0" Content="2.11" IsChecked="{Binding CheckForm211, Mode=TwoWay}"/>
                        <CheckBox Grid.Row="13" Grid.Column="1" Content="2.12" IsChecked="{Binding CheckForm212, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,0,0,8"
                    Padding="8"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Spacing="8">
                    <TextBlock Text="Период выгрузки:" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Opacity="0.85"
                               Text="Для форм 1.x — по датам начала/окончания отчёта; для форм 2.x — по году отчёта. Пустые поля — без ограничения по периоду."/>
                    <Grid ColumnDefinitions="*,Auto,*">
                        <CalendarDatePicker Grid.Column="0"
                                            Watermark="дд.мм.гг"
                                            Width="150"
                                            HorizontalAlignment="Stretch"
                                            SelectedDate="{Binding InitialDate, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Text="－"/>
                        <CalendarDatePicker Grid.Column="2"
                                            Watermark="дд.мм.гг"
                                            Width="150"
                                            HorizontalAlignment="Stretch"
                                            SelectedDate="{Binding ResidualDate, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Margin="0,0,0,12"
                    Padding="8"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Spacing="6">
                    <TextBlock Text="Папка для сохранения .RAODB:" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 IsReadOnly="True"
                                 Text="{Binding OutputFolderPath, Mode=TwoWay}"
                                 Watermark="Не выбрана"/>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="Обзор..."
                                Click="OnBrowseFolderClicked"
                                MinWidth="90"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="16">
                <Button Content="Запуск"
                        IsDefault="True"
                        Width="100"
                        Click="OnOkButtonClicked"/>
                <Button Content="Отмена"
                        IsCancel="True"
                        Width="100"
                        Click="OnCancelButtonClicked"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
