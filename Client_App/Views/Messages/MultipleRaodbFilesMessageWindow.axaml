<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Client_App.ViewModels.Messages"
        xmlns:behaviors="clr-namespace:Client_App.Behaviors"
        xmlns:customConverters="clr-namespace:Client_App.Resources.CustomConverters"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="280"
        behaviors:WindowScreenSizeBehavior.WidthRatio="0.42" 
        behaviors:WindowScreenSizeBehavior.HeightRatio="0.42"
        x:Class="Client_App.Views.Messages.MultipleRaodbFilesMessageWindow"
        Title="Выбор файла базы данных"
        WindowStartupLocation="Manual"
        MinWidth="460" MinHeight="320"
        Background="White">

    <Window.Resources>
        <customConverters:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
    </Window.Resources>

    <Design.DataContext>
        <vm:MultipleRaodbFilesMessageWindowVM/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <TextBlock Grid.Row="0"
                   Text="{x:Static vm:MultipleRaodbFilesMessageWindowVM.messageText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1"
                  Classes="dbPicker"
                  ItemsSource="{Binding Files}"
                  SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1"
                  RowBackground="White"
                  MinHeight="140"
                  MaxHeight="220">
            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Style>
                <Style Selector="DataGridColumnHeader TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Style>
                <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
                <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя файла БД"
                                    Binding="{Binding FileName}"
                                    Width="*"
                                    MinWidth="140"/>
                <DataGridTextColumn Header="Размер, Мб"
                                    Binding="{Binding SizeMb}"
                                    Width="100"/>
                <DataGridTextColumn Header="Дата изменения"
                                    Binding="{Binding LastModified}"
                                    Width="155"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Spacing="10">
            <Button Content="Открыть БД"
                    IsDefault="True"
                    IsEnabled="{Binding SelectedFile, Converter={StaticResource NotNullToBoolConverter}}"
                    Click="OnOpenClicked"
                    MinWidth="120"
                    MinHeight="28"
                    Padding="8,4"/>
            <Button Content="Открыть папку RAO"
                    Click="OnOpenRaoFolderClicked"
                    MinWidth="150"
                    MinHeight="28"
                    Padding="8,4"/>
            <Button Content="Выход"
                    IsCancel="True"
                    Click="OnExitClicked"
                    MinWidth="90"
                    MinHeight="28"
                    Padding="8,4"/>
        </StackPanel>
    </Grid>
</Window>
